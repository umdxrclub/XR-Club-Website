---
import AppLayout from '../layouts/AppLayout.astro';
import SuitsApplications from './SuitsApplications.astro';

import '../styles/suits-team.css';
import '../styles/suits-labs.css';
import '../styles/suits-workspace.css';
import '../styles/suits-space.css';
import '../styles/suits-directory.css';
const base = import.meta.env.BASE_URL;
interface Props { workspace?: boolean; preview?: boolean; }
const { workspace = false, preview = false } = Astro.props;
const sections = [
  { key: 'meetings', name: 'Calendar', icon: 'M4 5h16v15H4z M4 10h16 M8 3v4 M16 3v4' },
  { key: 'overview', name: 'Overview', icon: 'M3 3h7v7H3z M14 3h7v7h-7z M3 14h7v7H3z M14 14h7v7h-7z' },
  { key: 'tasks', name: 'Tasks', icon: 'M9 6h12 M9 12h12 M9 18h12 M2 5l2 2 3-4 M2 11l2 2 3-4 M2 17l2 2 3-4' },
  { key: 'proposal', name: 'Proposal', icon: 'M6 3h9l4 4v14H6z M14 3v5h5 M9 12h7 M9 16h7' },
  { key: 'documents', name: 'Documents', icon: 'M3 5h7l2 3h9v12H3z' },
  { key: 'team', name: 'Team', icon: 'M9 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8 M2 21v-2a7 7 0 0 1 14 0v2 M17 5a4 4 0 0 1 0 7 M19 15a5 5 0 0 1 3 5' },
  { key: 'applications', name: 'Applications', icon: 'M6 3h9l4 4v14H6z M14 3v5h5 M9 12h7 M9 16h7' },
];

---

<AppLayout title="SUITS Mission Dashboard" description="Team dashboard for the University of Maryland NASA SUITS proposal." hideChatBot noindex hideHeader={workspace} clientNavigation>
  <div class:list={["st-bg", { "st-workspace-bg": workspace }]} aria-hidden="true">
    <img class="st-bg__astronaut" src={`${base}scenes/suits-sky/${workspace ? "astronaut-source.jpg" : "login-source.png"}`} width="3840" height="2160" alt="" fetchpriority="high" decoding="async" />
    {workspace && <canvas class="st-sky-motion" aria-hidden="true" />}
    {workspace && <img class="st-bg__sky" src={`${base}scenes/suits-sky/sky-source.png`} width="2560" height="1440" alt="" decoding="async" />}
  </div>
  <div class="st" id="st" data-roles="[]" data-base={base} data-mode={workspace ? "workspace" : "login"} data-preview={preview && import.meta.env.DEV ? "true" : undefined}>
    <script is:inline>
      try {
        if (localStorage.getItem('xr-suits-theme') === 'dark') {
          document.getElementById('st').classList.add('is-dark');
          document.querySelector('.st-bg')?.classList.add('is-dark');
        }
      } catch (e) {}
    </script>

    <!-- Gate -->
    <section class="st-gate" id="st-gate" aria-labelledby="st-welcome">
      <div class="st-gate__card">
        <h1 class="st-gate__title" id="st-welcome">{workspace ? "Opening workspace…" : "Welcome aboard."}</h1>
        <p class="st-gate__text" id="st-gate-text">{workspace ? "One moment." : "Sign in with your UMD account."}</p>
        <div class="st-gate__error" id="st-gate-error" role="alert" hidden></div>
        <div id="st-google-host" hidden></div>
        <button type="button" class="st-btn st-btn--primary st-btn--wide" id="st-google" hidden={workspace}>
          <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9 3.6l6.7-6.7C35.7 2.6 30.2 0 24 0 14.6 0 6.5 5.4 2.6 13.3l7.8 6C12.3 13.6 17.7 9.5 24 9.5z"/><path fill="#4285F4" d="M46.5 24.5c0-1.6-.1-2.8-.4-4.1H24v7.8h12.9c-.3 2.1-1.7 5.3-4.8 7.5l7.4 5.7c4.4-4.1 7-10.1 7-16.9z"/><path fill="#FBBC05" d="M10.4 28.7c-.5-1.4-.8-3-.8-4.7s.3-3.3.8-4.7l-7.8-6C1 16.5 0 20.1 0 24s1 7.5 2.6 10.7l7.8-6z"/><path fill="#34A853" d="M24 48c6.5 0 11.9-2.1 15.9-5.8l-7.4-5.7c-2 1.4-4.7 2.4-8.5 2.4-6.3 0-11.7-4.1-13.6-9.9l-7.8 6C6.5 42.6 14.6 48 24 48z"/></svg>
          <span>Continue with Google</span>
        </button>
        <p class="st-gate__note" hidden={workspace}>Use your umd.edu or terpmail.umd.edu account.</p>
      </div>
    </section>

    <!-- App -->
    <main class="st-app" id="st-app" hidden>
      <header class="st-top">
        <a class="st-workspace-brand" href={`${base}suits/workspace/`} aria-label="Dreamers calendar">DREAMERS</a>
        <div class="st-top__actions">
          <button type="button" id="st-mobile-avatar" aria-label="Edit avatar"></button>
          <a class="st-workspace-home" href={base}>XR Labs</a>
          <button type="button" class="st-btn st-btn--small" id="st-layout">Layout</button>
          <button type="button" class="st-btn st-btn--small" id="st-theme">Night mode</button>
          <button type="button" class="st-btn st-btn--small" id="st-signout">Sign out</button>
        </div>
      </header>
      <div class="st-workspace">
        <aside class="st-side">
          <nav class="st-nav" id="st-nav" aria-label="Dashboard sections">
            {sections.map(section => <button type="button" class="st-nav__btn" data-nav={section.key} hidden={section.key === 'applications'} title={section.name} aria-label={section.name}><svg class="st-nav__icon" viewBox="0 0 24 24" aria-hidden="true"><path d={section.icon} /></svg><span class="st-nav__label">{section.name}</span></button>)}
          </nav>
          <div class="st-side__person"><span class="st-side__avatar" id="st-avatar"></span><div class="st-side__identity"><p class="st-top__sub" id="st-whoami"></p><button type="button" class="st-side__edit" id="st-edit-avatar">Edit avatar</button></div></div>
        </aside>
      <section class="st-view" data-view="overview" hidden>
        <div id="st-overview"></div>
      </section>

      <!-- Proposal: both NASA documents, page by page, with the parts for your role marked -->
      <section class="st-view" data-view="proposal" hidden>
        <div id="st-reader"></div>
      </section>

      <section class="st-view" data-view="tasks" hidden>
        <div id="st-tasks"></div>
      </section>

      <section class="st-view" data-view="meetings" hidden>
        <div id="st-meetings"></div>
      </section>

      <!-- Documents -->
      <section class="st-view" data-view="documents" hidden>
        <div id="st-documents"></div>
      </section>

      <section class="st-view" data-view="team" hidden>
        <div id="st-team"></div>
      </section>
      <section class="st-view" data-view="applications" hidden>
        <div id="st-applications"></div>
      </section>
      </div>
    </main>

    <div id="st-modal-host"></div>
    <SuitsApplications />
    {preview && import.meta.env.DEV && <div class="st-preview-note">Design preview · sample events · no messages sent</div>}
  </div>

  <script>
    import { boot } from '../scripts/suits/index';
    document.addEventListener('astro:page-load', () => { if (document.getElementById('st')) boot(); });
  </script>
</AppLayout>
