---
import { siteLinks } from '../config/site';
const base = import.meta.env.BASE_URL;
const activeSection = Astro.params.section ?? 'home';
const links = [
  { label: 'Home', href: siteLinks.home, section: 'home' },
  { label: 'About', href: siteLinks.about, section: 'about' },
  { label: 'Projects', href: siteLinks.projects, section: 'projects' },
  { label: 'Equipment', href: siteLinks.equipment, section: 'equipment' },
];
---
<header class="site-header" data-header>
  <div class="site-header__bar">
    <a href={siteLinks.home} class="site-header__brand" aria-label="XR Labs home" data-home-target="home">
      <span class="site-header__mark">
        <img src={base + 'brand/xr-labs-header.svg'} alt="XR Labs" width="1014" height="266" fetchpriority="high" />
      </span>
    </a>
    <nav class="site-header__nav" aria-label="Main navigation">
      {links.map(link => (
        <a href={link.href} data-home-target={link.section} data-home-section={link.section} aria-current={link.section === activeSection ? 'location' : undefined}>{link.label}</a>
      ))}
    </nav>
  </div>
</header>
<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-navigation, 1000);
    padding: 24px clamp(24px, 5vw, 76px) 18px;
    pointer-events: none;
    isolation: isolate;
    font-family: var(--font-site);
  }
  .site-header::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    background: linear-gradient(180deg, rgba(8,8,9,.24), transparent);
    pointer-events: none;
  }
  .site-header__bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: 32px;
    width: min(100%, 1280px);
    min-height: 58px;
    margin: 0 auto;
  }
  .site-header__bar::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -9px -18px;
    border: 1px solid #10151d40;
    border-radius: 18px;
    box-shadow: inset 0 1px 2px #080c1240, 0 1px 0 #ffffff30;
    pointer-events: none;
  }
  .site-header__brand { display: flex; align-items: center; flex: 0 0 174px; min-height: 48px; pointer-events: auto; }
  .site-header__mark { display: block; position: relative; width: 174px; }
  .site-header__brand img { display: block; width: 100%; height: auto; }
  .site-header__nav { display: flex; align-items: center; gap: clamp(28px, 3.2vw, 46px); margin-left: auto; pointer-events: auto; }
  .site-header__nav a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    color: #c9c9cb;
    font-size: 19px;
    font-weight: 500;
    letter-spacing: -.025em;
    line-height: 1;
    text-decoration: none;
    transition: color 160ms ease;
  }
  .site-header__nav a:hover, .site-header__nav a[aria-current='location'] { color: #fff; }
  :global(body:has([data-sky-header-tone='ink'])) .site-header__brand img { filter: invert(1); }
  :global(body:has([data-sky-header-tone='ink'])) .site-header__nav a { color: #50422e; }
  :global(body:has([data-sky-header-tone='ink'])) .site-header__nav a:is(:hover,[aria-current='location']) { color: #211b13; }
  :global(body:has([data-sky-header-tone='ink'])) .site-header::before { background: none; }
  :global(body:has([data-sky-phase='descent'])) .site-header::before { background: none; }
  .site-header a:focus-visible { outline: 2px solid #e6e6e6; outline-offset: 5px; border-radius: 4px; }
  @media (max-width: 900px) {
    .site-header { padding: 24px 32px 18px; }
    .site-header__brand { flex-basis: 156px; }
    .site-header__mark { width: 156px; }
    .site-header__nav { gap: 28px; }
    .site-header__nav a { font-size: 18px; }
  }
  @media (max-width: 640px) {
    .site-header { padding: 20px 24px 12px; }
    .site-header__bar { display: grid; grid-template-columns: 1fr; row-gap: 8px; }
    .site-header__bar::before { inset: -8px -12px; border-radius: 16px; }
    .site-header__brand { width: 146px; min-height: 44px; }
    .site-header__mark { width: 146px; }
    .site-header__nav { grid-row: 2; grid-column: 1 / -1; width: 100%; justify-content: space-between; gap: 16px; }
    .site-header__nav a { min-height: 44px; font-size: 17px; }
  }
  @media (max-width: 360px) {
    .site-header { padding: 16px 20px 10px; }
    .site-header__brand, .site-header__mark { width: 136px; }
    .site-header__nav { gap: 12px; }
    .site-header__nav a { font-size: 16px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header__nav a { transition: none; }
  }
</style>
<script>
  import { mountHomeNavigation } from '../lib/navigation';
  let dispose: (() => void) | undefined;
  document.addEventListener('astro:page-load', () => {
    dispose?.(); dispose = undefined;
    const header = document.querySelector<HTMLElement>('[data-header]');
    if (header) dispose = mountHomeNavigation(header);
  });
  document.addEventListener('astro:before-swap', () => { dispose?.(); dispose = undefined; });
</script>
