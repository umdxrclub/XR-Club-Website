---
import pageTransition from '../scripts/suitsPageTransition.js?raw';
---
<script is:inline set:html={pageTransition}></script>
<script>
  import '../scripts/suits/navigation';
</script>
<style is:global>
  @view-transition { navigation: auto; }
  html[data-suits-navigation]::view-transition { pointer-events:none; }
  html[data-suits-navigation]::view-transition-group(*) { animation:none; }
  html[data-suits-navigation]::view-transition-old(*),
  html[data-suits-navigation]::view-transition-new(*) { animation:none; mix-blend-mode:normal; }
  html[data-suits-navigation]::view-transition-old(root) { opacity:1; }
  html[data-suits-navigation]::view-transition-new(root) { clip-path:circle(0); }
  /* Arriving at the homepage: hold the outgoing page until the incoming one is complete, then cross-fade. */
  @keyframes home-arrival-hold { from, to { opacity:1; } }
  @keyframes home-arrival-out { to { opacity:0; } }
  @keyframes home-arrival-in { from { opacity:0; } }
  html[data-home-arrival]::view-transition { pointer-events:none; }
  html[data-home-arrival]::view-transition-group(root) { animation:none; }
  html[data-home-arrival]::view-transition-old(root) { animation:home-arrival-hold 11s linear both; }
  html[data-home-arrival]::view-transition-new(root) { animation:none; opacity:0; }
  html[data-home-arrival='ready']::view-transition-old(root) { animation:home-arrival-out .25s ease both; }
  html[data-home-arrival='ready']::view-transition-new(root) { animation:home-arrival-in .25s ease both; opacity:1; }
  @media(prefers-reduced-motion:reduce) {
    html[data-home-arrival='ready']::view-transition-old(root) { animation:none; opacity:0; }
    html[data-home-arrival='ready']::view-transition-new(root) { animation:none; opacity:1; }
  }
  @media(prefers-reduced-motion:reduce) { @view-transition { navigation:none; } }
</style>
