<template id="st-applications-template">
<div class="sd" id="sd">
    <header class="st-page-head sd__head">
      <h1 class="st-page-title">Applications</h1>
      <div class="st-page-actions">
        <button type="button" class="st-btn" id="sd-export">Export CSV</button>
      </div>
    </header>

    <div class="sd__filters">
      <div class="sd__segment" id="sd-status-filter" aria-label="Filter by application status">
        <button type="button" class="sd__seg is-active" data-status="">All</button>
        <button type="button" class="sd__seg" data-status="new">New</button>
        <button type="button" class="sd__seg" data-status="interview">Interview</button>
        <button type="button" class="sd__seg" data-status="accepted">Accepted</button>
        <button type="button" class="sd__seg" data-status="rejected">Rejected</button>
      </div>

      <div class="sd__tools">
        <input class="sd__search" id="sd-search" aria-label="Search applications" type="search" placeholder="Search applicants" autocomplete="off" />
        <select class="sd__select" id="sd-year" aria-label="Year">
          <option value="">Any year</option>
          <option>Freshman</option>
          <option>Sophomore</option>
          <option>Junior</option>
          <option>Senior</option>
          <option>5th Year or Above</option>
          <option>Graduate Student</option>
        </select>
        <select class="sd__select" id="sd-interest" aria-label="Interest">
          <option value="">Any interest</option>
          <option>XR and Unity Development</option>
          <option>UI and UX Design</option>
          <option>Navigation and Mapping</option>
          <option>AI and Machine Learning</option>
          <option>Systems and Telemetry Integration</option>
          <option>Voice Assistant</option>
          <option>Human Factors and UX Research</option>
          <option>Hardware and Peripherals</option>
          <option>Project Management</option>
          <option>Outreach and Industry Engagement</option>
          <option>Graphic Design and Media</option>
          <option>Documentation and Technical Writing</option>
          <option>Other</option>
        </select>
        <select class="sd__select" id="sd-eligible" aria-label="Eligibility">
          <option value="">Any eligibility</option>
          <option value="ok">Eligible and available</option>
          <option value="flag">Has a flag</option>
        </select>
        <select class="sd__select" id="sd-sort" aria-label="Sort applications">
          <option value="newest">Newest first</option>
          <option value="oldest">Oldest first</option>
          <option value="name">Name A to Z</option>
          <option value="hours">Most hours per week</option>
        </select>
      </div>
    </div>

    <div class="sd__body">
      <section class="sd__list" id="sd-list" aria-label="Applicants"></section>
      <p class="sd__empty" id="sd-empty" hidden>No matching applications</p>

      <section class="sd__detail" id="sd-detail" aria-live="polite">
        <div class="sd__detail-placeholder" id="sd-placeholder">
          <p>Select an applicant</p>
        </div>
        <div id="sd-detail-content" hidden></div>
      </section>
    </div>
  </div>
</template>
