---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getImage } from 'astro:assets';
import { firstHomePhoto, firstHomePhotoSizes, homePhotoWidths } from '../features/home/homePhotoSettings';
import Header from './Header.astro';
import HomeWaves from '../features/home/HomeWaves.astro';
import HomeGallery from '../features/home/HomeGallery.astro';
import HomeStatement from '../features/home/HomeStatement.astro';
import HomeProjectStory from '../features/projects/HomeProjectStory.astro';
import HomeIntro from '../features/home/HomeIntro.astro';
const openingPhoto = await getImage({ src: firstHomePhoto, width: 1600, widths: homePhotoWidths, format: 'webp', quality: 86 });
---

<BaseLayout title="XR Club">
  <script slot="head" is:inline data-astro-rerun>
    (() => {
      const root = document.documentElement;
      // Only a fresh load shows the HomeIntro sheet, and only on a browser's first visit: later loads come from cache and
      // open at once. (?intro in the address plays it again.) In-site arrivals keep the previous page on screen instead.
      let intro = document.readyState === 'loading';
      try {
        if (intro && localStorage.getItem('xr:home-intro') && !/[?&]intro\b/.test(location.search)) intro = false;
        if (intro) localStorage.setItem('xr:home-intro', String(Date.now()));
      } catch { /* Blocked storage behaves like a first visit. */ }
      // Deferred homepage work waits for xr:home-settled so it never stalls the folder's flip.
      const dismiss = () => {
        intro = false;
        document.querySelector('[data-home-intro]')?.remove();
        if (!root.hasAttribute('data-home-intro-on')) return;
        root.removeAttribute('data-home-intro-on');
        document.dispatchEvent(new CustomEvent('xr:home-settled'));
      };
      if (intro) root.setAttribute('data-home-intro-on', ''); else dismiss();
      document.addEventListener('xr:home-intro-done', dismiss, { once: true });
      // Chromium's full-page arrivals hold the previous page instead (PageTransitions marks those first).
      addEventListener('pagereveal', () => { if (root.hasAttribute('data-home-arrival')) dismiss(); }, { once: true });
      root.setAttribute('data-home-loading', '');
      root.removeAttribute('data-home-prepared');
      const shown = performance.now();
      let timer = 0, cap = 0, revealed = false;
      const reveal = () => {
        if (revealed) return;
        revealed = true;
        clearTimeout(fallback); clearTimeout(timer); clearTimeout(cap);
        document.removeEventListener('xr:home-ready', ready);
        document.removeEventListener('astro:before-swap', leave);
        if (!intro) dismiss();
        root.removeAttribute('data-home-loading'); root.removeAttribute('data-home-painting');
        document.dispatchEvent(new CustomEvent('xr:home-visible'));
        // HomeIntro turns the paper into the page; never leave it on screen if that script fails.
        if (intro) setTimeout(dismiss, 3000);
      };
      const ready = () => {
        if (!intro) { reveal(); return; }
        // Paint the page under the sheet first, and let the setup that would stutter it afterwards (the WebGL waves,
        // the glasses layers) run there too; the morph starts once that reports done (homeReady's markHomePrepared).
        root.setAttribute('data-home-painting', '');
        document.dispatchEvent(new CustomEvent('xr:home-painting'));
        const go = () => {
          clearTimeout(cap); document.removeEventListener('xr:home-prepared', go);
          requestAnimationFrame(() => requestAnimationFrame(() => {
            if (revealed) return;
            // Let the logo register before the sheet turns into the page, even when loading is instant.
            const wait = 750 - (performance.now() - shown);
            if (wait > 0) timer = setTimeout(reveal, wait); else reveal();
          }));
        };
        // A slow device still gets its page: the morph starts after 3 s even if setup is unfinished.
        cap = setTimeout(go, 3000);
        if (root.hasAttribute('data-home-prepared')) go(); else document.addEventListener('xr:home-prepared', go, { once: true });
      };
      const leave = () => { dismiss(); reveal(); };
      // Keep the server-rendered page usable if a script or image request fails.
      const fallback = setTimeout(reveal, 10000);
      document.addEventListener('xr:home-ready', ready, { once: true });
      document.addEventListener('astro:before-swap', leave);
    })();
  </script>
  <style slot="head" is:global>
    html[data-home-loading] body { pointer-events: none; }
    /* Unpainted while loading. With HomeIntro, the ready page paints once under its cover before the reveal. */
    html[data-home-loading]:not([data-home-painting]) body > :not([data-home-intro]) { opacity: 0; }
  </style>
  <link slot="head" rel="preload" as="image" href={openingPhoto.src} imagesrcset={openingPhoto.srcSet.attribute} imagesizes={firstHomePhotoSizes} fetchpriority="high" />
  <HomeIntro />
  <Header />
  <main id="home">
    <h1 class="visually-hidden">XR Club at the University of Maryland</h1>
    <HomeWaves>
      <HomeGallery />
      <HomeStatement />
      <HomeProjectStory />
    </HomeWaves>
  </main>
</BaseLayout>
