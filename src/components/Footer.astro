---
import githubMark from '../../public/brand/github-brand.svg?raw';
import steamMark from '../../public/brand/steam-brand.svg?raw';
import instagramMark from '../../public/brand/instagram-brand.svg?raw';
import linkedinMark from '../../public/brand/linkedin-brand.svg?raw';
import youtubeMark from '../../public/brand/youtube-brand.svg?raw';
import xMark from '../../public/brand/twitter-x-brand.svg?raw';
import discordMark from '../../public/brand/discord-brand.svg?raw';
import mailMark from '../../public/brand/envelope-brand.svg?raw';
const brand = (svg: string) => ({ icon: svg.match(/<path\b[^>]*\/>/g)?.join('') || '', viewBox: svg.match(/viewBox="([^"]+)"/)?.[1] || '0 0 24 24' });
const socialLinks = [
  { name: 'Discord', href: 'https://discord.gg/mn8ZKTwXFQ', ...brand(discordMark) },
  { name: 'Instagram', href: 'https://www.instagram.com/umdxrclub', ...brand(instagramMark) },
  { name: 'LinkedIn', href: 'https://www.linkedin.com/groups/8981512/', ...brand(linkedinMark) },
  { name: 'GitHub', href: 'https://github.com/umdxrclub', ...brand(githubMark) },
  { name: 'YouTube', href: 'https://youtube.com/@xrclub', ...brand(youtubeMark) },
  { name: 'X', href: 'https://twitter.com/umdxrclub', ...brand(xMark) },
  { name: 'Steam', href: 'https://steamcommunity.com/groups/xrclub', ...brand(steamMark) },
  { name: 'Email', href: 'mailto:umd.xr.club@gmail.com', ...brand(mailMark) },
];
---
<footer class="site-footer" aria-label="XR Club community">
  <div class="site-footer__inner">
    <nav aria-label="Connect with XR Club">
      {socialLinks.map(link => <a class:list={{ 'site-footer__discord': link.name === 'Discord', 'site-footer__email': link.name === 'Email', 'site-footer__icon': link.name !== 'Discord' }} href={link.href} target={link.name === 'Email' ? undefined : '_blank'} rel={link.name === 'Email' ? undefined : 'noopener noreferrer'} aria-label={link.name === 'Email' ? 'Email umd.xr.club@gmail.com' : link.name} title={link.name}>
        <svg viewBox={link.viewBox} fill="currentColor" width="23" height="23" aria-hidden="true" set:html={link.icon}/>{link.name === 'Discord' && <span>Discord</span>}
      </a>)}
    </nav>
  </div>
</footer>
<style>
  .site-footer { --discord-ink: #7887ff; position: fixed; inset: auto 0 0; z-index: 1100; height: var(--site-footer-height); padding-bottom: env(safe-area-inset-bottom); color: #f5f6f7; font-family: var(--font-site); font-size: 19px; font-weight: 600; letter-spacing: -.025em; }
  .site-footer__inner { display: flex; align-items: center; justify-content: flex-end; gap: 28px; width: min(1280px, calc(100% - 10vw)); height: 100%; margin: auto; }
  .site-footer nav { display: flex; align-items: center; gap: 12px; }
  .site-footer a { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; font: inherit; text-decoration: none; transition: opacity 150ms; }
  .site-footer__icon { width: 38px; opacity: .85; }
  .site-footer nav svg { width: 23px; height: 23px; }
  .site-footer a:hover { opacity: 1; }
  .site-footer a.site-footer__discord { color: var(--discord-ink); font-weight: 700; margin-right: 7px; gap: 8px; }
  .site-footer a.site-footer__email { color: inherit; opacity: 1; margin-left: 7px; }
  :global(body:has([data-home-waves][data-footer-tone='light'])) .site-footer nav { color: #24272b; }
  :global(body:has(.site-header--light)) .site-footer { --discord-ink: #6575ff; color: #24272b; }
  :global(body:has([data-sky-footer-tone='ink'])) .site-footer { --discord-ink: #414ca9; color: #392919; }
  :global(body:has([data-sky-footer-tone='sky-ink'])) .site-footer { --discord-ink: #414ca9; color: #15395e; }
  :global(body:has([data-sky-phase='descent'])) .site-footer { background: none; text-shadow: none; }
  .site-footer a:focus-visible { outline: 1px solid currentColor; outline-offset: 1px; border-radius: 4px; }
  @media(max-width:1000px) { .site-footer nav { gap: 8px; } }
  @media(max-width:900px) { .site-footer { font-size: 18px; } }
  @media(max-width:740px) {
    .site-footer__inner { justify-content: center; }
  }
  @media(max-width:640px) {
    .site-footer__inner { width: calc(100% - 32px); }
    .site-footer nav { width: 100%; justify-content: space-between; gap: 1px; }
    .site-footer { font-size: 17px; }
    .site-footer a { min-height: 44px; }
    .site-footer__icon { width: 32px; }
    .site-footer nav svg { width: 21px; height: 21px; }
    .site-footer a.site-footer__discord, .site-footer a.site-footer__email { margin: 0; }
    :global(body:has([data-home-waves][data-footer-tone='light'])) .site-footer nav a:nth-child(-n+3) { color: #f5f6f7; }
    :global(body:has([data-home-waves][data-footer-tone='light'])) .site-footer nav a.site-footer__discord { color: var(--discord-ink); }
  }
  @media(prefers-reduced-motion:reduce) { .site-footer a { transition: none; } }
</style>
