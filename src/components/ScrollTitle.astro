<span class="scroll-title" data-title-wipe>
  <span class="scroll-title__ink"><slot /></span>
  <i class="scroll-title__cursor" aria-hidden="true"></i>
</span>
<style>
  .scroll-title { position: relative; display: inline-block; max-width: 100%; vertical-align: baseline; opacity: clamp(0, calc(var(--title-reveal, 1) * 4), 1); }
  .scroll-title__ink { display: block; clip-path: inset(-.24em calc((1 - var(--title-reveal, 1)) * 100% - .025em) -.26em -.025em); }
  .scroll-title[data-complete] .scroll-title__ink { clip-path: none; }
  .scroll-title__cursor { position: absolute; top: .08em; bottom: .08em; left: calc(var(--title-reveal, 1) * 100%); width: .06em; background: currentColor; opacity: clamp(0, calc((1 - var(--title-reveal, 1)) * 30), 1); pointer-events: none; }
  @media (prefers-reduced-motion: reduce) {
    .scroll-title { opacity: 1; }
    .scroll-title__ink { clip-path: none; }
    .scroll-title__cursor { display: none; }
  }
  @media (forced-colors: active) { .scroll-title__cursor { background: CanvasText; } }
</style>