---
const base = import.meta.env.BASE_URL;
---

<div class="butterfly-scene" data-butterfly-scene data-base={base} aria-hidden="true"></div>
<div class="butterfly-controls" data-butterfly-controls hidden>
  <button class="butterfly-controls__button" data-butterfly-pause aria-label="Pause butterfly intro" title="Pause butterfly intro">
    <svg data-pause-icon width="12" height="12" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><path d="M3 2h2v8H3zm4 0h2v8H7z" /></svg>
    <svg data-play-icon width="12" height="12" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true" hidden><path d="m3 1 8 5-8 5z" /></svg>
  </button>
  <button class="butterfly-controls__button" data-butterfly-replay aria-label="Replay butterfly intro" title="Replay butterfly intro">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 10a8 8 0 1 1 1 8M4 3v7h7" /></svg>
  </button>
  <details class="butterfly-controls__credits">
    <summary>3D credits</summary>
    <div class="butterfly-controls__credit-card">
      <p>The butterfly is <a href="https://sketchfab.com/3d-models/fantasy-butterfly-animation-0f24b085e8654e4db09c2fe681a79e3f" target="_blank" rel="noopener noreferrer">Fantasy Butterfly Animation</a> by lunequinox on Sketchfab, shared under <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener noreferrer">CC BY 4.0</a>. We optimized its textures and changed its flight path.</p>
    </div>
  </details>
</div>

<style>
  .butterfly-scene { position: absolute; inset: 0; z-index: 5; pointer-events: none; }
  .butterfly-scene :global(canvas) { display: block; width: 100%; height: 100%; }
  .butterfly-controls { position: absolute; left: 50%; bottom: 10px; z-index: 6; transform: translateX(-50%); display: flex; align-items: center; gap: 8px; color: #bfc3cd; }
  [hidden] { display: none !important; }
  .butterfly-controls__button { width: 30px; height: 30px; display: grid; place-items: center; border: 1px solid #ffffff25; border-radius: 50%; background: #080a10b8; }
  .butterfly-controls__button:hover, .butterfly-controls__button:focus-visible { color: white; border-color: #ffffff80; }
  .butterfly-controls__credits { font-size: 10px; position: relative; }
  summary { cursor: pointer; list-style: none; padding: 8px 4px; text-shadow: 0 1px 4px #000; }
  summary::-webkit-details-marker { display: none; }
  .butterfly-controls__credit-card { position: absolute; bottom: 38px; left: 50%; transform: translateX(-50%); width: min(310px, 80vw); padding: 14px 16px; background: #101219f5; border: 1px solid #ffffff25; border-radius: 12px; font-size: 11px; line-height: 1.8; box-shadow: 0 8px 24px #0008; }
  .butterfly-controls__credit-card p { margin: 0; }
  .butterfly-controls__credit-card a { text-decoration: underline; text-underline-offset: 3px; color: #e5ddff; }
</style>

<script>
  import { MOBILE_HERO_QUERY } from '../scripts/heroMotion';
  const mobile = matchMedia(MOBILE_HERO_QUERY);
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
  let dispose: (() => void) | undefined;
  let generation = 0;
  const revealStill = () => {
    const hero = document.querySelector<HTMLElement>('[data-hero-wrapper]');
    if (!hero) return;
    hero.dataset.bubbleIntro = 'complete';
    hero.querySelector('[data-hero-bubble]')?.classList.add('is-drawn');
    document.dispatchEvent(new Event('xr:bubble-intro'));
  };
  const mount = async () => {
    const current = ++generation;
    dispose?.();
    dispose = undefined;
    const host = document.querySelector<HTMLElement>('[data-butterfly-scene]');
    if (!host) return;
    if (mobile.matches || reducedMotion.matches) { revealStill(); return; }
    try {
      const { mountButterflyScene } = await import('../scripts/butterflyScene');
      if (current !== generation || !host.isConnected) return;
      const cleanup = await mountButterflyScene(host);
      if (current !== generation || !host.isConnected) cleanup();
      else dispose = cleanup;
    } catch (error) {
      revealStill();
      console.warn('The butterfly intro could not load.', error);
    }
  };
  document.addEventListener('astro:page-load', mount);
  mobile.addEventListener('change', mount);
  reducedMotion.addEventListener('change', mount);
  document.addEventListener('astro:before-swap', () => { generation++; dispose?.(); dispose = undefined; });
</script>
