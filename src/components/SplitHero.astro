---
const base = import.meta.env.BASE_URL;
---
<section class="hero" data-hero>
  <img
    class="hero__bg"
    data-hero-background
    src={`${base}Images/homescreen-2560.webp`}
    srcset={`${base}Images/homescreen-1600.webp 1600w, ${base}Images/homescreen-2560.webp 2560w, ${base}Images/homescreen-3840.webp 3840w`}
    sizes="max(100vw, 200vh)"
    alt=""
    fetchpriority="high"
    decoding="async"
  />
</section>

<style>
  /* A 48px blurred copy of the artwork sits behind the real image, so the
     first frame is the artwork (soft) instead of black. */
  .hero {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: rgb(38,34,43) url("data:image/jpeg;base64,") center / cover no-repeat;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

</style>
