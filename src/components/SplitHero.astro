---
const base = import.meta.env.BASE_URL;
---
<section class="hero" data-hero>
  <img
    class="hero__bg"
    data-hero-background
    src={`${base}Images/homescreen-2560.webp`}
    srcset={`${base}Images/homescreen-1600.webp 1600w, ${base}Images/homescreen-2560.webp 2560w, ${base}Images/homescreen-3840.webp 3840w`}
    sizes="max(100vw, 200vh)"
    alt=""
    fetchpriority="high"
    decoding="async"
  />
  <!-- Use the artwork's native coordinates and the same right-aligned cover
       crop, so the stationary star stays attached to its photo at every size. -->
  <svg class="hero__star" viewBox="0 0 6912 3456" preserveAspectRatio="xMaxYMid slice" aria-hidden="true" focusable="false">
    <image href={`${base}models/homepage-star.png`} x="2368" y="2745" width="351" height="397" />
  </svg>
</section>

<style>
  /* A 48px blurred copy of the artwork sits behind the real image, so the
     first frame is the artwork (soft) instead of black. */
  .hero {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: rgb(38,34,43) url("data:image/jpeg;base64,") 100% 50% / cover no-repeat;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Anchor to the right edge: the Immersive Media Design credit lives in the
       artwork's bottom-right corner, so narrower screens crop the left instead. */
    object-position: 100% 50%;
    z-index: 0;
  }

  .hero__star {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    pointer-events: none;
    z-index: 1;
  }

</style>
