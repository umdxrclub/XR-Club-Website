---
const base = import.meta.env.BASE_URL;
---
<!--
  Night City behind the home page. A poster frame paints first, so the page is
  never blank, and a short muted loop fades in over it once the browser can
  play it. The script picks the smallest file that fits the screen.
-->
<section class="hero" data-hero data-video-base={`${base}video/`}>
  <picture>
    <source media="(max-width: 767px) and (orientation: portrait)" srcset={`${base}video/night-city-poster-portrait.webp`} />
    <img
      class="hero__bg"
      data-hero-background
      src={`${base}video/night-city-poster.webp`}
      alt=""
      fetchpriority="high"
      decoding="async"
    />
  </picture>
  <video class="hero__video" data-hero-video muted playsinline loop preload="none" aria-hidden="true" tabindex="-1" disablepictureinpicture disableremoteplayback></video>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #06080c;
  }

  .hero__bg,
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* The tall billboard tower sits right of center; keep it in frame as the
       viewport narrows instead of cropping it away. */
    object-position: 62% 50%;
  }

  .hero__bg {
    z-index: 0;
  }

  .hero__video {
    z-index: 1;
    opacity: 0;
    transition: opacity 600ms ease;
  }

  .hero__video.is-playing {
    opacity: 1;
  }

  @media (max-width: 767px) and (orientation: portrait) {
    .hero__bg,
    .hero__video {
      object-position: 50% 50%;
    }
  }
</style>

<script>
  let disposeVideo: (() => void) | undefined;

  const mountVideo = () => {
    disposeVideo?.();
    disposeVideo = undefined;
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    const video = hero?.querySelector<HTMLVideoElement>('[data-hero-video]');
    if (!hero || !video) return;

    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const connection = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
    const slow = !!connection?.saveData || /(^|-)2g$/.test(connection?.effectiveType || '');
    if (reducedMotion.matches || slow) return; // the poster is the background

    const base = hero.dataset.videoBase || '/video/';
    const portrait = matchMedia('(max-width: 767px) and (orientation: portrait)').matches;
    const small = Math.max(innerWidth, innerHeight) * Math.min(devicePixelRatio || 1, 2) <= 1300;
    const file = portrait ? 'night-city-portrait.mp4' : small ? 'night-city-720.mp4' : 'night-city-1080.mp4';

    const listeners = new AbortController();
    const { signal } = listeners;
    const show = () => video.classList.add('is-playing');
    video.addEventListener('playing', show, { signal });
    video.addEventListener('timeupdate', () => { if (video.currentTime > 0) show(); }, { signal, once: true });

    // Pause when the tab is hidden or the hero is scrolled away, resume when it is back
    const visible = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting && !document.hidden) video.play().catch(() => {});
        else video.pause();
      }
    }, { threshold: 0.05 });
    visible.observe(hero);
    document.addEventListener('visibilitychange', () => { if (document.hidden) video.pause(); else video.play().catch(() => {}); }, { signal });

    video.src = base + file;
    video.load();
    video.play().catch(() => { /* the poster stays until the browser allows playback */ });

    disposeVideo = () => {
      listeners.abort();
      visible.disconnect();
      video.pause();
      video.removeAttribute('src');
      video.load();
    };
  };

  document.addEventListener('astro:page-load', mountVideo);
  document.addEventListener('astro:before-swap', () => { disposeVideo?.(); disposeVideo = undefined; });
</script>
