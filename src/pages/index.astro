---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import SplitHero from '../components/SplitHero.astro';
import HeroWordmark from '../components/HeroWordmark.astro';
import ButterflyScene from '../components/ButterflyScene.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="XR Club">
  <link slot="head" rel="preload" as="image" href={`${base}Images/homescreen-2560.webp`} imagesrcset={`${base}Images/homescreen-1600.webp 1600w, ${base}Images/homescreen-2560.webp 2560w, ${base}Images/homescreen-3840.webp 3840w`} imagesizes="max(100vw, 200vh)" fetchpriority="high" />
  <link slot="head" rel="preload" as="image" href={`${base}Images/bubble-1400.webp`} imagesrcset={`${base}Images/bubble-1000.webp 1000w, ${base}Images/bubble-1400.webp 1400w, ${base}Images/bubble-2130.webp 2130w`} imagesizes="62vh" fetchpriority="high" />
  <Header />

  <section class="hero-section" data-hero-wrapper data-bubble-intro="pending">
    <SplitHero />
    <div class="hero-bubble" data-hero-bubble>
      <div class="hero-bubble__tilt" data-hero-tilt>
        <img class="hero-bubble__img" src={`${base}Images/bubble-1400.webp`} srcset={`${base}Images/bubble-1000.webp 1000w, ${base}Images/bubble-1400.webp 1400w, ${base}Images/bubble-2130.webp 2130w`} sizes="62vh" alt="" fetchpriority="high" decoding="async" />
        <h1 class="hero-bubble__heading">
          <span class="sr-only">XR Club</span>
          <HeroWordmark />
        </h1>
      </div>
    </div>
    <ButterflyScene />
  </section>
</BaseLayout>

<style>
  .hero-section {
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
  }

  /*
   * The butterfly reveals the existing bubble in place. Its resting size
   * matches the artwork (~31% of the 2:1 image width under object-fit: cover).
   */
  .hero-bubble {
    position: absolute;
    top: 50%;
    left: 50%;
    width: max(62vh, 31vw);
    width: max(62dvh, 31vw);
    z-index: 3;
    pointer-events: none;
    container-type: inline-size;
    transform: translate(-50%, -50%);
    perspective: 1200px;
  }

  /* Leans toward the cursor; --tilt-x/y are driven by the script below. */
  .hero-bubble__tilt {
    position: relative;
    transform-style: preserve-3d;
    transform: rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
    will-change: transform;
  }

  .hero-bubble__img {
    display: block;
    width: 100%;
    height: auto;
    opacity: 1;
    -webkit-mask-image: conic-gradient(from 315deg at 50% 50%, black 0deg, black max(0deg, calc(var(--bubble-reveal, 0deg) - 6deg)), transparent var(--bubble-reveal, 0deg), transparent 360deg);
    mask-image: conic-gradient(from 315deg at 50% 50%, black 0deg, black max(0deg, calc(var(--bubble-reveal, 0deg) - 6deg)), transparent var(--bubble-reveal, 0deg), transparent 360deg);
    will-change: transform;
  }

  /* The wordmark scales with the bubble, capped to fit narrow viewports. */
  .hero-bubble__heading {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) translateZ(60px);
    margin: 0;
    line-height: 1;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /*
   * Keep the bubble still while its outline is drawn. Gentle idle motion and
   * mouse-follow tilt begin only after the butterfly completes the reveal.
   */
  .hero-bubble.is-drawn {
    animation: bubble-float 7s ease-in-out infinite;
  }

  .hero-bubble.is-drawn .hero-bubble__img {
    -webkit-mask-image: none;
    mask-image: none;
    animation: bubble-breathe 5s ease-in-out infinite;
  }

  @keyframes bubble-float {
    0%,
    100% {
      transform: translate(-50%, -50%) rotate(0deg);
    }
    33% {
      transform: translate(-50%, calc(-50% - 1.5%)) rotate(0.6deg);
    }
    66% {
      transform: translate(-50%, calc(-50% + 1%)) rotate(-0.5deg);
    }
  }

  @keyframes bubble-breathe {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.015, 1.01);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-bubble.is-drawn,
    .hero-bubble.is-drawn .hero-bubble__img {
      animation: none;
    }

    .hero-bubble__img,
    .hero-bubble.is-drawn .hero-bubble__img {
      -webkit-mask-image: none;
      mask-image: none;
      opacity: 1;
      transform: none;
    }

    .hero-bubble__tilt {
      transform: none;
    }
  }

  /* A quiet, fitted logo on phones, including phone-sized landscape windows. */
  @media (max-width: 767px), (max-width: 1024px) and (max-height: 500px) {
    .hero-section {
      background: #08090d;
    }

    .hero-section :global([data-hero]),
    .hero-section :global([data-butterfly-scene]) {
      display: none;
    }

    .hero-bubble,
    .hero-bubble.is-drawn {
      width: min(88vw, 70vh, 480px);
      width: min(88vw, 70dvh, 480px);
      animation: none;
      transform: translate(-50%, -50%);
      perspective: none;
    }

    .hero-bubble__tilt {
      transform: none;
      transform-style: flat;
      will-change: auto;
    }

    .hero-bubble__img,
    .hero-bubble.is-drawn .hero-bubble__img {
      animation: none;
      -webkit-mask-image: none;
      mask-image: none;
      opacity: 1;
      transform: none;
      will-change: auto;
    }

    .hero-bubble__heading {
      transform: translate(-50%, -50%);
    }
  }
</style>

<script>
  import { MOBILE_HERO_QUERY } from '../scripts/heroMotion';

  let disposeHeroMotion: (() => void) | undefined;
  const mountHeroMotion = () => {
    disposeHeroMotion?.();
    disposeHeroMotion = undefined;
    const hero = document.querySelector<HTMLElement>('[data-hero-wrapper]');
    const bubble = document.querySelector<HTMLElement>('[data-hero-bubble]');
    const bubbleImg = bubble?.querySelector('img');
    const tilt = bubble?.querySelector<HTMLElement>('[data-hero-tilt]');
    if (!hero || !bubble || !bubbleImg || !tilt) return;

    const listeners = new AbortController();
    const { signal } = listeners;
    const mobile = matchMedia(MOBILE_HERO_QUERY);
    const finePointer = matchMedia('(hover: hover) and (pointer: fine)');
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    let targetX = 0, targetY = 0, currentX = 0, currentY = 0, raf = 0;
    let tiltEnabled = false;

    const resetTilt = () => {
      cancelAnimationFrame(raf);
      raf = targetX = targetY = currentX = currentY = 0;
      tilt.style.removeProperty('--tilt-x');
      tilt.style.removeProperty('--tilt-y');
    };
    const syncMotion = () => {
      if (mobile.matches || reducedMotion.matches) {
        const changed = hero.dataset.bubbleIntro !== 'complete';
        hero.dataset.bubbleIntro = 'complete';
        bubble.classList.add('is-drawn');
        if (changed) document.dispatchEvent(new Event('xr:bubble-intro'));
      }
      tiltEnabled = hero.dataset.bubbleIntro === 'complete' && !mobile.matches && finePointer.matches && !reducedMotion.matches;
      if (!tiltEnabled) resetTilt();
    };
    const render = () => {
      if (!tiltEnabled) { resetTilt(); return; }
      currentX += (targetX - currentX) * 0.08;
      currentY += (targetY - currentY) * 0.08;
      tilt.style.setProperty('--tilt-x', `${currentX.toFixed(2)}deg`);
      tilt.style.setProperty('--tilt-y', `${currentY.toFixed(2)}deg`);
      const settled = Math.abs(targetX - currentX) < 0.01 && Math.abs(targetY - currentY) < 0.01;
      raf = settled ? 0 : requestAnimationFrame(render);
    };
    const schedule = () => { if (!raf && tiltEnabled) raf = requestAnimationFrame(render); };

    hero.addEventListener('pointermove', (event) => {
      if (!tiltEnabled) return;
      const rect = hero.getBoundingClientRect();
      if (!rect.width || !rect.height) return;
      targetY = (((event.clientX - rect.left) / rect.width) * 2 - 1) * 12;
      targetX = -(((event.clientY - rect.top) / rect.height) * 2 - 1) * 8;
      schedule();
    }, { signal });
    hero.addEventListener('pointerleave', () => {
      targetX = targetY = 0;
      schedule();
    }, { signal });
    for (const query of [mobile, finePointer, reducedMotion]) query.addEventListener('change', syncMotion, { signal });
    document.addEventListener('xr:bubble-intro', syncMotion, { signal });
    syncMotion();
    disposeHeroMotion = () => {
      listeners.abort();
      resetTilt();
    };
  };
  document.addEventListener('astro:page-load', mountHeroMotion);
  document.addEventListener('astro:before-swap', () => {
    disposeHeroMotion?.();
    disposeHeroMotion = undefined;
  });
</script>
