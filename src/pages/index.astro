---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import SplitHero from '../components/SplitHero.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="XR Club" chat={false}>
  <link slot="head" rel="preload" as="image" href={`${base}video/night-city-poster-v2.webp`} media="(min-width: 768px), (orientation: landscape)" fetchpriority="high" />
  <link slot="head" rel="preload" as="image" href={`${base}video/night-city-poster-portrait-v2.webp`} media="(max-width: 767px) and (orientation: portrait)" fetchpriority="high" />
  <Header />

  <section class="hero-section" data-hero-wrapper>
    <SplitHero />
  </section>
</BaseLayout>

<style>
  .hero-section {
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    background: #06080c;
  }
</style>
