  </style>

  <style is:global>
    /* White page behind the form (the layout's body is dark). */
    .sa-bg {
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      background: var(--page, #fff);
    }

    /* Inline validation messages are created by the script, so they need a global rule. */
    .sa .sa__field-error {
      display: block;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      font-size: 0.92rem;
      font-weight: 500;
      line-height: 1.4;
      color: var(--danger, #d70015);
      margin-top: 0.55rem;
    }
  </style>

  <script>
    const DRAFT_KEY = 'xr-suits-application-draft';
    const MAX_RESUME_BYTES = 10 * 1024 * 1024;

    const REQUIRED_TEXT = [
      'full_name', 'email', 'discord_username', 'majors', 'organizations',
      'bring_to_table', 'why_join', 'teamwork_story', 'team_environment',
      'availability_changes',
    ];
    const REQUIRED_RADIO = ['year', 'hours_per_week', 'required_dates', 'us_citizen_or_pr'];

    document.addEventListener('astro:page-load', () => {
      const form = document.getElementById('suits-form') as HTMLFormElement | null;
      if (!form) return;

      const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
      const submitError = document.getElementById('submit-error') as HTMLElement;
      const confirmCard = document.getElementById('suits-confirm') as HTMLElement;
      const confirmCheck = document.getElementById('confirm-check') as HTMLInputElement;
      const calSummary = document.getElementById('cal-summary') as HTMLElement;
      const saveStatus = document.getElementById('save-status') as HTMLElement;
      const draftNotice = document.getElementById('draft-notice') as HTMLElement;
      const done = document.getElementById('suits-done') as HTMLElement;

      const resumeInput = document.getElementById('resume') as HTMLInputElement;
      const resumeDrop = document.getElementById('resume-drop') as HTMLElement;
      const resumeEmpty = document.getElementById('resume-empty') as HTMLElement;
      const resumeFileRow = document.getElementById('resume-file') as HTMLElement;
      const resumeName = document.getElementById('resume-name') as HTMLElement;
      const resumeSize = document.getElementById('resume-size') as HTMLElement;
      const resumeReattach = document.getElementById('resume-reattach') as HTMLElement;

      const otherWrap = document.getElementById('interest-other-wrap') as HTMLElement;
      const otherCheckbox = form.querySelector<HTMLInputElement>('input[name="interest_areas"][value="Other"]')!;

      let resumeFile: File | null = null;

      // ---------------------------------------------------------------
      // Night mode
      // ---------------------------------------------------------------
      const THEME_KEY = 'xr-suits-theme';
      const page = document.getElementById('suits-app')!;
      const backdrop = document.querySelector('.sa-bg');
      const themeBtn = document.getElementById('theme-toggle') as HTMLButtonElement;
      const themeLabel = document.getElementById('theme-label')!;

      function applyTheme(dark: boolean) {
        page.classList.toggle('is-dark', dark);
        backdrop?.classList.toggle('is-dark', dark);
        themeBtn.setAttribute('aria-pressed', String(dark));
        themeLabel.textContent = dark ? 'Day mode' : 'Night mode';
      }

      let darkMode = false;
      try { darkMode = localStorage.getItem(THEME_KEY) === 'dark'; } catch { /* storage unavailable */ }
      applyTheme(darkMode);

      themeBtn.addEventListener('click', () => {
        darkMode = !darkMode;
        try { localStorage.setItem(THEME_KEY, darkMode ? 'dark' : 'light'); } catch { /* ignore */ }
        applyTheme(darkMode);
      });

      // ---------------------------------------------------------------
      // Draft: everything except the file is kept in localStorage
      // ---------------------------------------------------------------
      function readForm(): Record<string, string | string[] | boolean> {
        const data: Record<string, string | string[] | boolean> = {};
        form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea').forEach(el => {
          if (el.type === 'file') return;
          if (el.type === 'radio') {
            if (el.checked) data[el.name] = el.value;
          } else if (el.type === 'checkbox') {
            const list = (data[el.name] as string[]) || [];
            if (el.checked) list.push(el.value);
            data[el.name] = list;
          } else {
            data[el.name] = el.value;
          }
        });
        data.hadResume = !!resumeFile;
        return data;
      }

      function applyDraft(data: Record<string, unknown>) {
        form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea').forEach(el => {
          if (el.type === 'file') return;
          const v = data[el.name];
          if (el.type === 'radio') {
            el.checked = v === el.value;
          } else if (el.type === 'checkbox') {
            el.checked = Array.isArray(v) && v.includes(el.value);
          } else if (typeof v === 'string') {
            el.value = v;
          }
        });
        syncOther();
        limited.forEach(updateCounter);
        updateCalSummary();
        if (data.hadResume) resumeReattach.hidden = false;
      }

      let saveTimer = 0;
      function saveDraft() {
        window.clearTimeout(saveTimer);
        saveTimer = window.setTimeout(() => {
          try {
            localStorage.setItem(DRAFT_KEY, JSON.stringify(readForm()));
            saveStatus.textContent = 'Progress saved.';
          } catch {
            /* storage unavailable: the form still works, it just won't persist */
          }
        }, 250);
      }

      function clearDraft() {
        try { localStorage.removeItem(DRAFT_KEY); } catch { /* ignore */ }
      }

      document.getElementById('draft-clear')!.addEventListener('click', () => {
        clearDraft();
        form.reset();
        setResume(null);
        syncOther();
        draftNotice.hidden = true;
        resumeReattach.hidden = true;
        saveStatus.textContent = 'Your progress is saved automatically on this device.';
        form.querySelectorAll('.is-invalid').forEach(el => el.classList.remove('is-invalid'));
        form.querySelectorAll('.sa__field-error').forEach(el => el.remove());
        limited.forEach(updateCounter);
        updateCalSummary();
      });

      form.addEventListener('input', saveDraft);
      form.addEventListener('change', saveDraft);

      // ---------------------------------------------------------------
      // "Other" interest reveals a text field
      // ---------------------------------------------------------------
      function syncOther() {
        otherWrap.hidden = !otherCheckbox.checked;
      }
      otherCheckbox.addEventListener('change', syncOther);
      syncOther();

      // ---------------------------------------------------------------
      // Word counters on the long answers
      // ---------------------------------------------------------------
      function wordCount(text: string) {
        const t = text.trim();
        return t ? t.split(/\s+/).length : 0;
      }

      function updateCounter(el: HTMLTextAreaElement) {
        const max = Number(el.dataset.maxWords);
        const counter = form.querySelector<HTMLElement>(`[data-count-for="${el.name}"]`);
        if (!counter) return;
        const n = wordCount(el.value);
        counter.textContent = `${n} / ${max} words`;
        counter.classList.toggle('is-over', n > max);
      }

      const limited = Array.from(form.querySelectorAll<HTMLTextAreaElement>('textarea[data-max-words]'));
      limited.forEach(el => el.addEventListener('input', () => updateCounter(el)));

      // ---------------------------------------------------------------
      // Interview calendar: day headers toggle a whole column
      // ---------------------------------------------------------------
      const slots = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="interview_slots"]'));

      function updateCalSummary() {
        const n = slots.filter(s => s.checked).length;
        calSummary.textContent = n === 0 ? 'No times selected yet.' : n === 1 ? '1 time selected.' : `${n} times selected.`;
      }
      slots.forEach(s => s.addEventListener('change', updateCalSummary));

      form.querySelectorAll<HTMLButtonElement>('.sa__cal-day').forEach(btn => {
        btn.addEventListener('click', () => {
          const day = slots.filter(s => s.dataset.day === btn.dataset.day);
          const allOn = day.every(s => s.checked);
          day.forEach(s => { s.checked = !allOn; });
          updateCalSummary();
          clearFieldError(fieldFor('interview_slots'));
          saveDraft();
        });
      });

      try {
        const raw = localStorage.getItem(DRAFT_KEY);
        if (raw) {
          const data = JSON.parse(raw);
          const hasContent = Object.values(data).some(v => (Array.isArray(v) ? v.length > 0 : typeof v === 'string' && v.trim() !== ''));
          if (hasContent) {
            applyDraft(data);
            draftNotice.hidden = false;
          }
        }
      } catch { /* ignore a corrupt draft */ }

      // ---------------------------------------------------------------
      // Resume upload
      // ---------------------------------------------------------------
      function formatSize(bytes: number) {
        return bytes < 1024 * 1024 ? `${Math.round(bytes / 1024)} KB` : `${(bytes / 1024 / 1024).toFixed(1)} MB`;
      }

      function setResume(file: File | null) {
        resumeFile = file;
        if (file) {
          resumeName.textContent = file.name;
          resumeSize.textContent = formatSize(file.size);
          resumeEmpty.hidden = true;
          resumeFileRow.hidden = false;
          resumeReattach.hidden = true;
          clearFieldError(resumeDrop.closest('.sa__field') as HTMLElement);
        } else {
          resumeInput.value = '';
          resumeEmpty.hidden = false;
          resumeFileRow.hidden = true;
        }
        saveDraft();
      }

      function acceptFile(file: File | undefined) {
        if (!file) return;
        const field = resumeDrop.closest('.sa__field') as HTMLElement;
        const isPdf = file.type === 'application/pdf' || file.name.toLowerCase().endsWith('.pdf');
        if (!isPdf) { setFieldError(field, 'Please upload a PDF.'); return; }
        if (file.size > MAX_RESUME_BYTES) { setFieldError(field, 'That file is over 10 MB.'); return; }
        setResume(file);
      }

      document.getElementById('resume-choose')!.addEventListener('click', () => resumeInput.click());
      resumeInput.addEventListener('change', () => acceptFile(resumeInput.files?.[0]));
      document.getElementById('resume-remove')!.addEventListener('click', () => setResume(null));

      ['dragenter', 'dragover'].forEach(evt => resumeDrop.addEventListener(evt, e => { e.preventDefault(); resumeDrop.classList.add('is-over'); }));
      ['dragleave', 'drop'].forEach(evt => resumeDrop.addEventListener(evt, e => { e.preventDefault(); resumeDrop.classList.remove('is-over'); }));
      resumeDrop.addEventListener('drop', e => acceptFile((e as DragEvent).dataTransfer?.files?.[0]));

      // ---------------------------------------------------------------
      // Validation
      // ---------------------------------------------------------------
      function fieldFor(name: string): HTMLElement {
        return (form.querySelector(`[data-group="${name}"]`) || form.querySelector(`[name="${name}"]`)!.closest('.sa__field')) as HTMLElement;
      }

      function setFieldError(field: HTMLElement, message: string) {
        field.classList.add('is-invalid');
        let msg = field.querySelector<HTMLElement>('.sa__field-error');
        if (!msg) {
          msg = document.createElement('span');
          msg.className = 'sa__field-error';
          field.appendChild(msg);
        }
        msg.textContent = message;
      }

      function clearFieldError(field: HTMLElement) {
        field.classList.remove('is-invalid');
        field.querySelector('.sa__field-error')?.remove();
      }

      form.addEventListener('input', e => {
        const field = (e.target as HTMLElement).closest('.sa__field') as HTMLElement | null;
        if (field?.classList.contains('is-invalid')) clearFieldError(field);
      });
      form.addEventListener('change', e => {
        const field = (e.target as HTMLElement).closest('.sa__field') as HTMLElement | null;
        if (field?.classList.contains('is-invalid')) clearFieldError(field);
      });

      function validate(): HTMLElement | null {
        let first: HTMLElement | null = null;
        const flag = (field: HTMLElement, message: string) => {
          setFieldError(field, message);
          if (!first) first = field;
        };

        for (const name of REQUIRED_TEXT) {
          const el = form.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[name="${name}"]`)!;
          const field = fieldFor(name);
          if (!el.value.trim()) { flag(field, 'This one is required.'); continue; }
          if (name === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(el.value.trim())) flag(field, 'Enter a valid email address.');
        }

        for (const el of limited) {
          if (wordCount(el.value) > Number(el.dataset.maxWords)) flag(fieldFor(el.name), `Keep this under ${el.dataset.maxWords} words.`);
        }

        for (const name of REQUIRED_RADIO) {
          if (!form.querySelector(`input[name="${name}"]:checked`)) flag(fieldFor(name), 'Choose one.');
        }

        if (!form.querySelector('input[name="interest_areas"]:checked')) flag(fieldFor('interest_areas'), 'Pick at least one.');
        if (otherCheckbox.checked && !(form.querySelector<HTMLInputElement>('[name="interest_other"]')!.value.trim())) {
          flag(fieldFor('interest_areas'), 'Add the role you have in mind under Other.');
        }

        if (!slots.some(s => s.checked)) flag(fieldFor('interview_slots'), 'Pick at least one time.');

        if (!resumeFile) flag(fieldFor('resume'), 'Attach your resume as a PDF.');

        return first;
      }

      // ---------------------------------------------------------------
      // Submit
      // ---------------------------------------------------------------
      function value(name: string) {
        return (form.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[name="${name}"]`)?.value || '').trim();
      }
      function radio(name: string) {
        return (form.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)?.value || '');
      }
      function orNull(s: string) {
        return s === '' ? null : s;
      }

      form.addEventListener('submit', e => {
        e.preventDefault();

        const firstInvalid = validate();
        if (firstInvalid) {
          firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
          const focusable = firstInvalid.querySelector<HTMLElement>('input:not([type="file"]), textarea, button');
          focusable?.focus({ preventScroll: true });
          return;
        }

        form.hidden = true;
        draftNotice.hidden = true;
        confirmCard.hidden = false;
        confirmCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });

      confirmCheck.addEventListener('change', () => { submitBtn.disabled = !confirmCheck.checked; });

      document.getElementById('confirm-back')!.addEventListener('click', () => {
        confirmCard.hidden = true;
        form.hidden = false;
        submitError.hidden = true;
        form.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });

      submitBtn.addEventListener('click', async () => {
        if (!confirmCheck.checked) return;
        submitError.hidden = true;

        // The review step already validated, but never trust that: a field could
        // have been changed since, and the file lives outside the form state.
        const stillInvalid = validate();
        if (stillInvalid) {
          confirmCard.hidden = true;
          form.hidden = false;
          stillInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
          return;
        }
        submitBtn.disabled = true;
        submitBtn.textContent = 'Submitting…';

        try {
          // Loaded on demand so the form itself never depends on Supabase being reachable.
          const { supabase } = await import('../../lib/supabase');
          const id = crypto.randomUUID();
          const safeName = resumeFile!.name.replace(/[^\w.\-]+/g, '_').slice(-80);
          const resumePath = `${id}/${safeName}`;

          const { error: uploadError } = await supabase.storage
            .from('suits-resumes')
            .upload(resumePath, resumeFile!, { contentType: 'application/pdf', upsert: false });
          if (uploadError) throw new Error(`Resume upload failed: ${uploadError.message}`);

          const interests = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="interest_areas"]:checked')).map(i => i.value);

          const { error: insertError } = await supabase.from('suits_applications').insert({
            id,
            full_name: value('full_name'),
            email: value('email'),
            discord_username: value('discord_username'),
            year: radio('year'),
            majors: value('majors'),
            minors: orNull(value('minors')),
            organizations: value('organizations'),
            resume_path: resumePath,
            portfolio_url: orNull(value('portfolio_url')),
            bring_to_table: value('bring_to_table'),
            why_join: value('why_join'),
            teamwork_story: value('teamwork_story'),
            team_environment: value('team_environment'),
            interest_areas: interests,
            interest_other: otherCheckbox.checked ? orNull(value('interest_other')) : null,
            hours_per_week: radio('hours_per_week'),
            availability_changes: value('availability_changes'),
            required_dates: radio('required_dates'),
            us_citizen_or_pr: radio('us_citizen_or_pr'),
            interview_slots: slots.filter(s => s.checked).map(s => s.value),
            anything_else: orNull(value('anything_else')),
          });
          if (insertError) throw new Error(insertError.message);

          document.getElementById('done-name')!.textContent = value('full_name').split(' ')[0];
          document.getElementById('done-email')!.textContent = value('email');
          clearDraft();
          confirmCard.hidden = true;
          done.hidden = false;
          done.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } catch (err) {
          submitError.textContent = `Something went wrong and your application was not submitted. ${(err as Error).message}`;
          submitError.hidden = false;
          submitError.scrollIntoView({ behavior: 'smooth', block: 'center' });
          submitBtn.disabled = false;
          submitBtn.textContent = 'Submit application';
        }
      });
    });
  </script>
</AppLayout>
