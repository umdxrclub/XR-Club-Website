---
import { portraitPhotoContour, portraitPhotoMask } from '../../lib/folderShape';
---
{/* Shown only on a fresh load while the homepage finishes behind it; SitePage's head script turns it on. */}
<div class="home-intro" data-home-intro aria-hidden="true">
  <div class="home-intro__card" data-home-intro-card>
    <div class="home-intro__face home-intro__front">
      <svg class="home-intro__paper" viewBox="0 0 1 1" preserveAspectRatio="none">
        <path d={portraitPhotoContour} fill="#eeede9" />
        <path d="M.008 .956H.052Q.060 .956 .060 .968V1Q.046 1 .038 .990Z" fill="#e0dfda" />
      </svg>
      {/* The header's logo (public/brand/xr-labs-header.svg), large and drawn in the paper's ink; it glides into the header when the page is ready.
          The letters are cut out of the badge, so they show the paper here and the dark page at the header without a colour change of their own. */}
      <svg class="home-intro__logo" viewBox="-16 -6 1014 266" data-home-intro-logo>
        <path data-badge fill-rule="evenodd" fill="#24252a" d="M224 13C176 13 76-3 35 24C2 46-10 90-5 140C0 192 14 232 56 246C100 261 157 247 191 232C205 226 215 222 224 222C233 222 243 226 257 232C291 247 348 261 392 246C434 232 448 192 453 140C458 90 446 46 413 24C372-3 272 13 224 13ZM66 44H109L143 89L178 44H222L168 116L227 193H181L142 143L105 193H60L117 117ZM242 44H321C361 44 382 63 382 94C382 118 368 134 346 141L389 193H342L301 144H282V193H242ZM282 78V111H317C333 111 342 106 342 94C342 82 333 78 317 78Z" />
        <g data-word fill="none" stroke="#24252a" stroke-width="27" stroke-linecap="butt" stroke-linejoin="round">
          <path d="M500 23V184Q500 201 518 201" />
          <path d="M658 82V201M658 141C658 106 638 81 607 81C576 81 555 107 555 142C555 177 576 202 607 202C638 202 658 177 658 141Z" />
          <path d="M706 23V201M706 142C706 107 727 81 758 81C789 81 810 107 810 142C810 177 789 202 758 202C727 202 706 177 706 142Z" />
          <path d="M958 95C944 85 927 81 909 81C882 81 861 93 861 113C861 135 882 140 911 146C940 152 959 159 959 178C959 195 940 204 913 204C892 204 871 197 855 185" />
        </g>
      </svg>
    </div>
    {/* The opening photo goes here when the page is ready, so the folder flips over into it. */}
    <div class="home-intro__face home-intro__back" data-home-intro-back style={`--photo-mask: ${portraitPhotoMask}`}></div>
  </div>
</div>

<style>
  .home-intro { display: none; }
  :global(html[data-home-intro-on]) .home-intro { position: fixed; inset: 0; z-index: 2000; display: block; overflow: hidden; pointer-events: none; }
  /* The paper is oversized so its tab and rounded corners wait beyond the screen; only the folded corner shows until it shrinks. */
  .home-intro__card { position: absolute; left: 0; top: -4.6%; width: 104%; height: 104.6%; container-type: size; transform-style: preserve-3d; will-change: transform; }
  .home-intro__face { position: absolute; inset: 0; backface-visibility: hidden; -webkit-backface-visibility: hidden; }
  /* Firefox only hides a turned-away face that has its own 3D transform. */
  .home-intro__front { transform: translateZ(0); }
  .home-intro__back { transform: rotateY(180deg); overflow: hidden; mask-image: var(--photo-mask); mask-size: 100% 100%; mask-repeat: no-repeat; -webkit-mask-image: var(--photo-mask); -webkit-mask-size: 100% 100%; -webkit-mask-repeat: no-repeat; }
  .home-intro__back :global(img) { display: block; width: 100%; height: auto; }
  .home-intro__paper { position: absolute; inset: 0; width: 100%; height: 100%; }
  /* Half the paper's width on a laptop, most of it on a phone. While gliding to the header it is placed directly on the screen (homeIntro.ts). */
  .home-intro__logo { position: absolute; left: 50%; top: 50%; width: min(80vw, 760px); aspect-ratio: 1014 / 266; translate: -50% -50%; animation: home-intro-in .6s cubic-bezier(.2, .7, .2, 1) both; }
  @supports (width: 1cqw) { .home-intro__logo { width: max(min(80cqw, 340px), 50cqw); } }
  @keyframes home-intro-in { from { opacity: 0; scale: .96; } 60% { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .home-intro__logo { animation: none; } }
</style>

<script>
  import { mountHomeIntro } from './homeIntro';
  mountHomeIntro();
</script>
