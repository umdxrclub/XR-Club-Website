---
import { folderContour } from '../../lib/folderShape';
import AriaAssembly from './AriaAssembly.astro';
const { decorative = false, exploded = false } = Astro.props;
---
<div class="project-folder" aria-hidden={decorative ? 'true' : undefined}>
  <svg class="project-folder__surface" viewBox="0 0 1 1" preserveAspectRatio="none" aria-hidden="true">
    <path d={folderContour} fill="#eeede9" />
    <path d="M.012 .878H.074Q.086 .878 .086 .908V1Q.066 1 .054 .975Z" fill="#e0dfda" />
  </svg>
  <div class="project-folder__paper">
    <span class="project-folder__label">Build with us</span>
    {decorative ? <span class="project-folder__title">Projects.</span> : <h2 class="project-folder__title" id="home-projects-title">Projects.</h2>}
  </div>
  <AriaAssembly decorative={decorative} exploded={exploded} />
</div>
<style>
  .project-folder { position: relative; isolation: isolate; width: 100%; height: 100%; color: #24252a; font-family: var(--font-site); container-type: inline-size; }
  /* Paint the complete surface once; no separate CSS mask layer to reraster
     during the scroll flip or the cursor tilt. */
  .project-folder__surface { position: absolute; z-index: 0; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .project-folder__paper { position: absolute; z-index: 2; inset: 0; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; gap: 14px; padding: 30px clamp(32px, 5cqw, 68px) 24px; }
  .project-folder__label { font-size: clamp(20px, 2.4cqw, 28px); font-weight: 500; line-height: 1.25; color: #53555c; letter-spacing: -.03em; }
  /* Align the visible edge of the large P with the smaller label above it. */
  .project-folder__title { font-family: var(--font-title); display: block; margin: 0 0 0 -.035em; font-size: clamp(56px, 12cqw, 148px); font-weight: 600; line-height: 1.04; letter-spacing: -.045em; }
  @media (forced-colors: active) {
    .project-folder__title { color: CanvasText; }
  }
  @media(max-width:640px) {
    .project-folder__paper { padding: 24px 26px; gap: 10px; justify-content: flex-start; }
    .project-folder__title { font-size: clamp(50px, 19cqw, 80px); }
  }
  @media(max-height:650px) { .project-folder__title { font-size: clamp(50px, 10cqw, 100px); } .project-folder__paper { gap: 8px; padding-top: 18px; padding-bottom: 18px; } }
  @media(max-width:640px) and (max-height:740px) { .project-folder__paper { gap: 6px; padding-top: 20px; } .project-folder__label { font-size: 17px; } .project-folder__title { font-size: 48px; } }
</style>
