---
import projects from '../../data/projects.json';
import ProjectBrief from './ProjectBrief.astro';
import ProjectFolder from './ProjectFolder.astro';
import ProjectTabs from './ProjectTabs.astro';
import FolderButtonShape from '../../components/FolderButtonShape.astro';
import { folderMask } from '../../lib/folderShape';
import { siteLinks } from '../../config/site';
const { id = 'project-cabinet', overview = true } = Astro.props;
const titleFor = (name: string) => name.includes('Rosetta') ? 'The Rosetta Engine' : name.includes('Project ARIA') ? 'Project Aria' : name.includes(' - ') ? name.split(' - ').slice(1).join(' ') : name;
---
<section class="cabinet" id={id} aria-label="Project folders" data-project-cabinet data-overview={overview ? '' : undefined} style={`--folder-mask: ${folderMask}`}>
  <div class="cabinet__desk" data-project-deck>
    <ProjectTabs id={id} overview={overview} />
    <div class="cabinet__overview" data-project-overview hidden={!overview} inert={!overview}>
      <div class="cabinet__landing" data-project-landing><ProjectFolder /></div>
      <div class="cabinet__overview-copy" data-project-details>
        <div class="cabinet__intro">
          <p>Build your own idea or join a team. We provide the equipment, funding, and space to make it happen.</p>
          <span class="cabinet__note">No prior experience is required.</span>
        </div>
        <div class="cabinet__actions">
          <button type="button" data-enter-project="0"><FolderButtonShape /><span>Explore projects</span></button>
          <a href={siteLinks.ideate}>Propose a project</a>
        </div>
      </div>
    </div>
    <div class="cabinet__stack" data-project-stack>
      {projects.map((project, index) => <article class="project-file" id={`${id}-panel-${index}`} aria-labelledby={`${id}-title-${index}`} hidden={index !== 0} data-project-panel>
        <header class="project-file__heading">
          <button class="project-file__back" type="button" data-project-back aria-label="Back to Page">
            <span>Back to Page</span>
          </button>
          <h3 id={`${id}-title-${index}`} tabindex="-1">{titleFor(project.name)}</h3>
        </header>
        <div class="project-file__body" tabindex="0" role="region" aria-label={`${titleFor(project.name)} project brief`}><ProjectBrief project={project} /></div>
      </article>)}
    </div>
  </div>
</section>
<style>
  .cabinet { position: relative; display: flex; flex-direction: column; color: #282d2e; font-family: var(--font-site); scroll-margin-top: 128px; }
  .cabinet__desk { position: relative; height: calc(100svh - var(--site-footer-height) - var(--project-top, 112px) - var(--project-bottom, 24px)); min-height: 0; }
  .cabinet[data-overview] .cabinet__stack { visibility: hidden; pointer-events: none; }
  .cabinet__overview { position: absolute; inset: 0; z-index: 2; display: grid; grid-template-rows: minmax(200px, 1fr) auto; gap: clamp(24px, 4svh, 40px); color: #fff; pointer-events: none; }
  .cabinet__overview[hidden] { display: none; }
  .cabinet__landing { position: relative; min-height: 0; height: 100%; }
  .cabinet__overview-copy { display: grid; grid-template-columns: minmax(0, 1fr) minmax(190px, 264px); align-items: center; gap: 24px 38px; padding: 0 4px; pointer-events: auto; }
  .cabinet__intro { display: grid; gap: 16px; }
  .cabinet__intro p { max-width: 510px; font-size: clamp(18px, 1.5vw, 23px); line-height: 1.45; letter-spacing: -.025em; text-wrap: pretty; text-shadow: 0 2px 3px rgb(16 13 40 / .42), 0 5px 14px rgb(16 13 40 / .28); }
  .cabinet__note { display: block; font-size: 14px; line-height: 1.5; color: #fffc; }
  .cabinet__actions { display: flex; flex-direction: column; align-items: stretch; justify-self: end; gap: 8px; width: min(100%, 264px); }
  .cabinet__actions :is(button,a) { display: inline-flex; align-items: center; justify-content: center; gap: 18px; min-height: 48px; padding: 10px 20px; font-size: 17px; font-weight: 550; line-height: 1.3; letter-spacing: -.025em; white-space: nowrap; }
  .cabinet__actions button { position: relative; isolation: isolate; transform: translateZ(0); background: none; --folder-button-fill: #eeede9; color: #24252a; cursor: pointer; }
  .cabinet__actions button > span { position: relative; z-index: 1; }
  .cabinet__actions button:hover { --folder-button-fill: #fff; }
  .cabinet__actions a { text-decoration: underline; text-underline-offset: 5px; text-decoration-color: #ffffff70; }
  .cabinet__actions a:hover { text-decoration-color: currentColor; }
  .cabinet__stack { position: absolute; inset: 0; z-index: 1; perspective: 1000px; isolation: isolate; container-type: size; pointer-events: none; }
  .project-file { position: absolute; inset: 0; display: flex; flex-direction: column; padding: 28px 36px 24px; transform-origin: 75% 20%; }
  .project-file[hidden] { display: none; }
  .project-file::before { content: ''; position: absolute; z-index: -1; inset: 0; background: #eeede9; mask: var(--folder-mask) 0 0 / 100% 100% no-repeat; -webkit-mask: var(--folder-mask) 0 0 / 100% 100% no-repeat; pointer-events: none; }
  .project-file__heading { flex-shrink: 0; padding-bottom: 12px; }
  .project-file__back { display: inline-flex; align-items: center; gap: 9px; min-height: 44px; margin: -14px 0 4px -4px; padding: 0 4px; color: #48584d; font-size: 16px; font-weight: 550; letter-spacing: -.035em; pointer-events: auto; cursor: pointer; }
  .project-file__back:hover { color: #24362a; }
  .project-file__back:hover span { text-decoration: underline; text-underline-offset: 4px; }
  .project-file__heading h3 { font-size: clamp(29px, 4.2cqw, 43px); font-weight: 500; line-height: 1.14; letter-spacing: -.05em; }
  .project-file__body { flex: 1; min-height: 0; overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin; scrollbar-color: #bdc2be transparent; padding-right: 4px; pointer-events: auto; }
  .cabinet :is(button,a,[tabindex]):focus-visible { outline: 2px solid #78967b; outline-offset: 3px; border-radius: 3px; }
  @media(min-width:641px) and (max-width:1000px) {
    .cabinet__overview-copy { grid-template-columns: minmax(0, 1fr) minmax(170px, 230px); gap: 24px; }
  }
  @media(max-width:640px) {
    .cabinet__overview { grid-template-rows: minmax(160px, 1fr) auto; gap: 22px; }
    .cabinet__overview-copy { grid-template-columns: 1fr; gap: 16px; padding: 0; }
    .cabinet__intro { gap: 12px; }
    .cabinet__intro p { font-size: 17px; line-height: 1.5; }
    .cabinet__note { font-size: 12px; }
    .cabinet__actions { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; justify-self: stretch; width: 100%; }
    .cabinet__actions :is(button,a) { min-height: 44px; padding: 9px 10px; font-size: 14px; }
    .project-file { padding: 25px 23px 25px; }
    .project-file__heading { padding-bottom: 12px; }
    .project-file__back { font-size: 14px; margin-bottom: 8px; }
    .project-file__heading h3 { font-size: 28px; }
    .project-file__body { padding-right: 2px; }
  }
  @media(max-height:650px) {
    .cabinet__overview { grid-template-rows: minmax(160px, 1fr) auto; gap: 16px; }
    .cabinet__intro { gap: 10px; }
    .cabinet__intro p { font-size: 16px; line-height: 1.4; }
    .cabinet__note { font-size: 12px; }
  }
  @media(max-height:480px) and (min-width:641px) {
    .cabinet__overview { grid-template-rows: minmax(110px, 1fr) auto; gap: 10px; }
    .cabinet__overview-copy { grid-template-columns: minmax(0, 1fr) 248px; gap: 16px; }
    .cabinet__intro { gap: 6px; }
    .cabinet__intro p { font-size: 14px; line-height: 1.35; }
    .cabinet__note { font-size: 11px; line-height: 1.3; }
    .cabinet__actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; width: 248px; }
    .cabinet__actions :is(button,a) { min-height: 44px; padding: 8px; font-size: 13px; }
  }
  @media(prefers-reduced-motion:reduce) { .cabinet__actions button { transition: none; } }
  @container (max-height: 360px) { .project-file { padding-top: 22px; padding-bottom: 25px; } .project-file__heading h3 { font-size: 28px; } .project-file__back { margin-bottom: 8px; } }
</style>
<script>
  import { mountProjectCabinets } from './projectCabinet';
  let dispose: (() => void) | undefined;
  document.addEventListener('astro:page-load', () => { dispose?.(); dispose = mountProjectCabinets(); });
  document.addEventListener('astro:before-swap', () => { dispose?.(); dispose = undefined; });
</script>
