---
const { decorative = false, exploded = false } = Astro.props;
const source = `${import.meta.env.BASE_URL}scenes/aria/aria-render-original.webp`;
---
<div class="aria-assembly" data-aria-assembly data-aria-mode={decorative ? (exploded ? 'complete' : 'hidden') : 'scroll'} data-aria-source={source} aria-hidden="true">
  {(exploded || !decorative) && <>
    <svg class="aria-assembly__fallback" viewBox="352 137 1205 811" preserveAspectRatio="xMidYMax meet" aria-hidden="true">
      <image href={source} width="1920" height="1080" />
    </svg>
    <div class="aria-assembly__art" data-aria-art></div>
  </>}
</div>
<style>
  .aria-assembly { position: absolute; z-index: 2; top: 13%; right: 3.3%; bottom: 9%; width: 44%; overflow: clip; pointer-events: none; }
  .aria-assembly__art { position: absolute; bottom: 0; left: 50%; transform: translateX(-50%) scaleX(-1); }
  .aria-assembly__art :global(canvas) { display: block; position: absolute; }
  .aria-assembly[data-aria-mode="scroll"] .aria-assembly__art { visibility: hidden; }
  .aria-assembly[data-aria-ready] .aria-assembly__art { visibility: inherit; }
  .aria-assembly__fallback { position: absolute; bottom: 0; left: 0; width: 100%; height: 100%; transform: scaleX(-1); mix-blend-mode: darken; }
  .aria-assembly[data-aria-mode="scroll"] .aria-assembly__fallback,
  .aria-assembly[data-aria-ready] .aria-assembly__fallback { visibility: hidden; }
  @media(max-width:640px) {
    .aria-assembly { top: 152px; right: 7%; bottom: 24px; width: 86%; }
  }
  @media(max-width:640px) and (max-height:740px) {
    .aria-assembly { top: 114px; bottom: 16px; }
  }
  @media(prefers-reduced-motion:reduce) {
    .aria-assembly[data-aria-mode="scroll"]:not([data-aria-ready]) .aria-assembly__fallback { visibility: visible; }
  }
</style>
<script>
  import { mountAriaAssembly } from './ariaAssembly';
  let dispose: (() => void) | undefined;
  document.addEventListener('astro:page-load', () => { dispose?.(); dispose = mountAriaAssembly(); });
  document.addEventListener('astro:before-swap', () => { dispose?.(); dispose = undefined; });
</script>
