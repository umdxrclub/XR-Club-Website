---
import projects from '../../data/projects.json';
const { id = 'project-files' } = Astro.props;
const titleFor = (name: string) => name.includes('Rosetta') ? 'The Rosetta Engine' : name.includes('Project ARIA') ? 'Project Aria' : name.includes(' - ') ? name.split(' - ').slice(1).join(' ') : name;
---
<div class="folder-tabs">
  <svg class="folder-tabs__roof" viewBox="0 0 1000 1000" preserveAspectRatio="none" aria-hidden="true"><path d="M516 0H942Q954 0 960 12L988 68Q1000 92 1000 166H516Z" /></svg>
  <div class="folder-tabs__navigation">
    <button class="folder-tabs__all" type="button" data-project-picker-toggle aria-expanded="false" aria-controls={`${id}-picker`}>
      <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 5h14M3 10h14M3 15h14" /></svg>
      <span>All projects</span>
    </button>
  </div>
  <div class="folder-tabs__picker" id={`${id}-picker`} data-project-picker hidden>
    <ul aria-label="All projects">
      {projects.map((project, index) => <li><button type="button" data-project-choice={index} aria-controls={`${id}-panel-${index}`}>{titleFor(project.name)}</button></li>)}
    </ul>
  </div>
</div>
<style>
  .folder-tabs { position: absolute; inset: 0; pointer-events: none; }
  :global(.cabinet[data-overview]) .folder-tabs { display: none; }
  .folder-tabs__roof { position: absolute; z-index: 0; inset: 0; width: 100%; height: 100%; fill: #d8dad6; pointer-events: none; }
  .folder-tabs__navigation { position: absolute; z-index: 4; left: 62%; right: 4%; top: 0; height: max(10%, 44px); display: flex; justify-content: flex-end; align-items: center; pointer-events: auto; }
  .folder-tabs__all { min-height: 44px; display: inline-flex; align-items: center; gap: 9px; padding: 0 4px; color: #303b34; font: 550 15px/1.2 var(--font-site); letter-spacing: -.035em; white-space: nowrap; cursor: pointer; }
  .folder-tabs__all svg { width: 18px; height: 18px; stroke: currentColor; stroke-width: 1.2; stroke-linecap: round; }
  .folder-tabs__all:is(:hover,[aria-expanded='true']) { color: #101b15; }
  .folder-tabs__all[aria-expanded='true'] span { text-decoration: underline; text-underline-offset: 5px; }
  .folder-tabs__picker { position: absolute; z-index: 6; right: 0; top: max(10%, 46px); width: min(490px, 100%); padding: 12px 18px; border-radius: 14px; background: #f5f5f0; box-shadow: 0 8px 24px #10151224; pointer-events: auto; }
  .folder-tabs__picker[hidden] { display: none; }
  .folder-tabs__picker ul { display: grid; grid-template-columns: 1fr 1fr; gap: 0 20px; max-height: min(390px, calc(100svh - var(--site-footer-height) - 290px)); overflow-y: auto; overscroll-behavior: contain; list-style: none; margin: 0; padding: 0; scrollbar-width: thin; }
  .folder-tabs__picker li { border-bottom: 1px solid #263c2914; }
  .folder-tabs__picker li:nth-last-child(-n+2) { border-bottom: 0; }
  .folder-tabs__picker button { display: block; width: 100%; min-height: 44px; padding: 9px 2px; color: #536058; text-align: left; font: 500 13px/1.35 var(--font-site); letter-spacing: -.025em; cursor: pointer; }
  .folder-tabs__picker button:is(:hover,:focus-visible), .folder-tabs__picker button[aria-current='true'] { color: #172d1d; text-decoration: underline; text-underline-offset: 4px; }
  @media(max-width:640px) {
    .folder-tabs__navigation { left: 61%; right: 5%; }
    .folder-tabs__all { font-size: 13px; gap: 6px; }
    .folder-tabs__all svg { width: 15px; }
    .folder-tabs__picker { padding: 10px 14px; }
    .folder-tabs__picker ul { gap: 0 14px; }
    .folder-tabs__picker button { font-size: 12px; }
  }
</style>
