---
import { Image } from 'astro:assets';
import FolderButtonShape from '../../components/FolderButtonShape.astro';
import { availabilityOptions, fundingRules, proposal, teams, whatHappensNext, years } from './applyContent';
import poster1 from '../../assets/apply/immersive-installations-poster-1.png';
import poster2 from '../../assets/apply/immersive-installations-poster-2.png';
const base = import.meta.env.BASE_URL;
const posters = [poster1, poster2];
---
<main class="apply" data-apply data-arrival-hold>
  <canvas class="apply__fluid" data-apply-fluid aria-hidden="true"></canvas>
  <div class="apply__shade" aria-hidden="true"></div>
  <canvas class="apply__swimmer" data-apply-swimmer aria-hidden="true"></canvas>

  <div class="apply__scroller" data-apply-scroller>
    {/* Every step sits on one stage pinned to the screen; the scroller behind it only supplies the position that drives the morph. */}
    <div class="apply__deck" data-apply-deck>
      <div class="apply__stage" data-apply-stage>
        <section class="apply__step" data-step="intro" data-flow="start" data-shown>
          <div class="apply__panel">
            <h1 class="apply__title">Projects</h1>
            <p class="apply__lead">Three projects are taking new members this semester. Apply to one, or propose a new project and request funding for it.</p>
            <div class="apply__cards" role="list">
              {teams.map(team => (
                <button type="button" class="apply__card" role="listitem" data-team-pick={team.slug}>
                  <FolderButtonShape shortTab />
                  <span class="apply__card-body">
                    <span class="apply__card-name">{team.name}</span>
                    <span class="apply__card-text">{team.tagline}</span>
                    <span class="apply__card-cta">Apply</span>
                  </span>
                </button>
              ))}
              <button type="button" class="apply__card" role="listitem" data-next>
                <FolderButtonShape shortTab />
                <span class="apply__card-body">
                  <span class="apply__card-name">{proposal.name}</span>
                  <span class="apply__card-text">{proposal.tagline}</span>
                  <span class="apply__card-cta">{proposal.cta}</span>
                </span>
              </button>
            </div>
          </div>
        </section>

        <form class="apply__form" data-apply-form="pitch" novalidate autocomplete="on">
          <input type="text" name="website" class="apply__honey" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <section class="apply__step" data-step="project" data-flow="pitch">
            <div class="apply__panel">
              <h2 class="apply__title">Project and team</h2>
              <div class="apply__row">
                <label class="apply__field"><span class="apply__label">Project name</span><input class="apply__input" name="project_title" type="text" required maxlength="120" placeholder="Short and memorable" /></label>
                <label class="apply__field"><span class="apply__label">Topic <em>optional</em></span><input class="apply__input" name="topic" type="text" maxlength="120" placeholder="A board topic or your own direction" /></label>
              </div>
              <label class="apply__field"><span class="apply__label">Summary</span><textarea class="apply__input apply__input--area" name="idea" required maxlength="600" rows="2" placeholder="What you are building, who it is for, and why XR"></textarea></label>
              <h3 class="apply__subtitle">Team</h3>
              <p class="apply__help">Three to ten people, including you.</p>
              <div class="apply__row">
                <label class="apply__field"><span class="apply__label">Your name</span><input class="apply__input" name="lead_name" type="text" required maxlength="120" autocomplete="name" /></label>
                <label class="apply__field"><span class="apply__label">UMD email</span><input class="apply__input" name="lead_email" type="email" required maxlength="160" autocomplete="email" placeholder="you@terpmail.umd.edu" data-umd-email /></label>
              </div>
              <label class="apply__field"><span class="apply__label">Discord username</span><input class="apply__input" name="lead_discord" type="text" required maxlength="80" autocomplete="off" /></label>
              <label class="apply__field"><span class="apply__label">Team members, one per line</span><textarea class="apply__input apply__input--area" name="members" required rows="3" placeholder="Name, year, role" data-members></textarea><span class="apply__hint" data-members-count></span></label>
              <div class="apply__actions"><button type="button" class="apply__link" data-back>Back</button><button type="button" class="apply__button" data-next><FolderButtonShape /><span>Continue</span></button></div>
            </div>
          </section>

          <section class="apply__step" data-step="plan" data-flow="pitch">
            <div class="apply__panel">
              <h2 class="apply__title">Plan</h2>
              <label class="apply__field"><span class="apply__label">Outline and MVP</span><textarea class="apply__input apply__input--area" name="outline" required rows="3" placeholder="The smallest version that works, then what you build on top of it"></textarea></label>
              <label class="apply__field"><span class="apply__label">Plan without funding</span><textarea class="apply__input apply__input--area" name="zero_dollar_plan" required rows="2" placeholder="What you can build with lab equipment alone if funding is reduced or unavailable"></textarea></label>
              <label class="apply__field"><span class="apply__label">Timeline</span><textarea class="apply__input apply__input--area" name="timeline" required rows="2" placeholder="Checkpoints are every 2 to 3 weeks. What is done at each one, through the end of the semester"></textarea></label>
              <label class="apply__field"><span class="apply__label">Deliverable</span><textarea class="apply__input apply__input--area" name="deliverable" required rows="2" placeholder="What you will show at Demo Day"></textarea></label>
              <div class="apply__actions"><button type="button" class="apply__link" data-back>Back</button><button type="button" class="apply__button" data-next><FolderButtonShape /><span>Continue</span></button></div>
            </div>
          </section>

          <section class="apply__step" data-step="budget" data-flow="pitch">
            <div class="apply__panel">
              <h2 class="apply__title">Budget</h2>
              <p class="apply__help">Hardware only. Mark each item must have or nice to have. Leave this empty if lab equipment is enough.</p>
              <div class="apply__budget" data-budget>
                <div class="apply__budget-head" aria-hidden="true"><span>Item</span><span>Estimated cost</span><span>Priority</span></div>
                <div data-budget-rows></div>
                <template data-budget-row>
                  <div class="apply__budget-row">
                    <input class="apply__input" type="text" name="budget_name" maxlength="120" placeholder="Item" aria-label="Item" />
                    <input class="apply__input" type="number" name="budget_cost" min="0" step="0.01" inputmode="decimal" placeholder="$" aria-label="Estimated cost in dollars" />
                    <span class="apply__segment" role="group" aria-label="Priority">
                      <button type="button" data-priority="must" aria-pressed="true">Must have</button>
                      <button type="button" data-priority="nice" aria-pressed="false">Nice to have</button>
                      <input type="hidden" name="budget_priority" value="must" />
                    </span>
                    <input class="apply__input" type="url" name="budget_link" maxlength="400" placeholder="https://" aria-label="Link" />
                    <button type="button" class="apply__remove" data-budget-remove aria-label="Remove item">×</button>
                  </div>
                </template>
                <div class="apply__budget-foot">
                  <button type="button" class="apply__link" data-budget-add>Add item</button>
                  <p class="apply__total">Total requested <strong data-budget-total>$0</strong></p>
                </div>
              </div>
              <label class="apply__field"><span class="apply__label">Lab equipment you will use <em>optional</em></span><input class="apply__input" name="lab_equipment" type="text" maxlength="300" placeholder="Quest 3, PSVR2, HoloLens, the treadmill" /></label>
              <details class="apply__rules">
                <summary>Funding rules</summary>
                <div class="apply__rules-grid">
                  <div><h3>Funding covers</h3><ul>{fundingRules.can.map(item => <li>{item}</li>)}</ul></div>
                  <div><h3>Funding does not cover</h3><ul>{fundingRules.cannot.map(item => <li>{item}</li>)}</ul></div>
                </div>
                <ul class="apply__rules-notes">{fundingRules.notes.map(item => <li>{item}</li>)}</ul>
              </details>
              <div class="apply__actions"><button type="button" class="apply__link" data-back>Back</button><button type="button" class="apply__button" data-next><FolderButtonShape /><span>Review</span></button></div>
            </div>
          </section>

          <section class="apply__step" data-step="pitch-review" data-flow="pitch">
            <div class="apply__panel">
              <h2 class="apply__title">Review</h2>
              <dl class="apply__summary" data-pitch-summary></dl>
              <label class="apply__check"><input type="checkbox" name="agreed_to_rules" required /><span>We have read the funding rules: hardware only, orders go through the Treasurer, no reimbursements, hardware stays with the club, and funds are released in stages with checkpoints.</span></label>
              <p class="apply__error" data-form-error hidden></p>
              <div class="apply__actions"><button type="button" class="apply__link" data-back>Back</button><button type="submit" class="apply__button" data-submit><FolderButtonShape /><span>Submit proposal</span></button></div>
            </div>
          </section>

          <section class="apply__step" data-step="pitch-done" data-flow="pitch" hidden>
            <div class="apply__panel">
              <h2 class="apply__title">Proposal received</h2>
              <ol class="apply__next">{whatHappensNext.map(item => <li>{item}</li>)}</ol>
              <div class="apply__actions">
                <a class="apply__button" href={base}><FolderButtonShape /><span>Back to home</span></a>
                <button type="button" class="apply__link" data-jump="intro">View projects</button>
              </div>
            </div>
          </section>
        </form>

        <form class="apply__form" data-apply-form="team" novalidate autocomplete="on">
          <input type="hidden" name="team" data-team-field />
          <input type="text" name="website" class="apply__honey" tabindex="-1" autocomplete="off" aria-hidden="true" />
          {/* The team form stays off the deck until a project is picked, so scrolling cannot reach it empty. */}
          <section class="apply__step" data-step="team-info" data-flow="team" hidden>
            <div class="apply__panel apply__panel--wide">
              {teams.map(team => (
                <article class="apply__team-info" data-team-info={team.slug} hidden>
                  <h2 class="apply__title">{team.name}</h2>
                  <div class="apply__team-columns">
                    <div class="apply__team-text">
                      {team.summary.map(paragraph => <p>{paragraph}</p>)}
                      {team.roles && <p class="apply__team-roles"><strong>Roles:</strong> {team.roles.join(', ')}</p>}
                      {team.people && <p class="apply__team-roles"><strong>Team:</strong> {team.people.join(', ')}</p>}
                    </div>
                    <div class="apply__team-side">
                      {team.posters && <div class="apply__posters">{posters.map((poster, index) => <Image src={poster} alt={index === 0 ? 'Immersive Installations poster: Mondays 4 to 5 pm, AVW 4176' : 'Poster: audio reactive, body tracking, performance, projection mapping. All immersive installations welcome.'} width={520} widths={[260, 520, 780]} sizes="(max-width: 700px) 42vw, 190px" format="webp" quality={82} loading="lazy" />)}</div>}
                      <dl class="apply__details">{team.details.map(detail => <div><dt>{detail.label}</dt><dd>{detail.value}</dd></div>)}</dl>
                    </div>
                  </div>
                  <div class="apply__actions"><button type="button" class="apply__link" data-jump="intro">All projects</button><button type="button" class="apply__button" data-next><FolderButtonShape /><span>Apply</span></button></div>
                </article>
              ))}
            </div>
          </section>

          <section class="apply__step" data-step="about" data-flow="team" hidden>
            <div class="apply__panel">
              <h2 class="apply__title">About you</h2>
              <div class="apply__row">
                <label class="apply__field"><span class="apply__label">Name</span><input class="apply__input" name="full_name" type="text" required maxlength="120" autocomplete="name" /></label>
                <label class="apply__field"><span class="apply__label">UMD email</span><input class="apply__input" name="email" type="email" required maxlength="160" autocomplete="email" placeholder="you@terpmail.umd.edu" data-umd-email /></label>
              </div>
              <div class="apply__row">
                <label class="apply__field"><span class="apply__label">Discord username</span><input class="apply__input" name="discord_username" type="text" required maxlength="80" autocomplete="off" /></label>
                <label class="apply__field"><span class="apply__label">Major <em>and minor, if any</em></span><input class="apply__input" name="major" type="text" required maxlength="160" /></label>
              </div>
              <fieldset class="apply__field apply__fieldset">
                <legend class="apply__label">Year</legend>
                <div class="apply__chips apply__chips--radio">
                  {years.map(year => <label class="apply__chip"><input type="radio" name="year" value={year} required /><span>{year}</span></label>)}
                </div>
              </fieldset>
              <div class="apply__actions"><button type="button" class="apply__link" data-back>Back</button><button type="button" class="apply__button" data-next><FolderButtonShape /><span>Continue</span></button></div>
            </div>
          </section>

          <section class="apply__step" data-step="fit" data-flow="team" hidden>
            <div class="apply__panel">
              <h2 class="apply__title">Your fit</h2>
              {teams.map(team => <p class="apply__help" data-team-question={team.slug} hidden>{team.question}</p>)}
              <label class="apply__field"><span class="apply__label">Your answer</span><textarea class="apply__input apply__input--area" name="pitch" required rows="3" maxlength="2000"></textarea></label>
              <fieldset class="apply__field apply__fieldset">
                <legend class="apply__label">Tools you have used <em>optional</em></legend>
                {teams.map(team => (
                  <div class="apply__chips" data-team-tools={team.slug} hidden>
                    {team.tools.map(tool => <label class="apply__chip"><input type="checkbox" name="tools" value={tool} /><span>{tool}</span></label>)}
                  </div>
                ))}
              </fieldset>
              <label class="apply__field"><span class="apply__label">Link <em>optional</em></span><input class="apply__input" name="link" type="url" maxlength="400" placeholder="Portfolio, GitHub, or a video" /></label>
              <fieldset class="apply__field apply__fieldset">
                <legend class="apply__label">Availability</legend>
                {teams.map(team => <p class="apply__help apply__help--tight" data-team-meeting={team.slug} hidden>This team meets {team.meeting}.</p>)}
                <div class="apply__chips apply__chips--radio">
                  {availabilityOptions.map(option => <label class="apply__chip"><input type="radio" name="availability" value={option.value} required /><span>{option.label}</span></label>)}
                </div>
              </fieldset>
              <label class="apply__field"><span class="apply__label">Anything else <em>optional</em></span><textarea class="apply__input apply__input--area" name="anything_else" rows="1" maxlength="1000"></textarea></label>
              <div class="apply__actions"><button type="button" class="apply__link" data-back>Back</button><button type="button" class="apply__button" data-next><FolderButtonShape /><span>Review</span></button></div>
            </div>
          </section>

          <section class="apply__step" data-step="team-review" data-flow="team" hidden>
            <div class="apply__panel">
              <h2 class="apply__title">Review</h2>
              <dl class="apply__summary" data-team-summary></dl>
              <p class="apply__error" data-form-error hidden></p>
              <div class="apply__actions"><button type="button" class="apply__link" data-back>Back</button><button type="submit" class="apply__button" data-submit><FolderButtonShape /><span>Submit application</span></button></div>
            </div>
          </section>

          <section class="apply__step" data-step="team-done" data-flow="team" hidden>
            <div class="apply__panel">
              <h2 class="apply__title">Application received</h2>
              <p class="apply__lead">The team will contact you on Discord or by email with the next meeting. The <a href="https://discord.gg/mn8ZKTwXFQ" target="_blank" rel="noopener noreferrer">XR Club Discord</a> is where everything happens.</p>
              <div class="apply__actions">
                <a class="apply__button" href={base}><FolderButtonShape /><span>Back to home</span></a>
                <button type="button" class="apply__link" data-jump="intro">View projects</button>
              </div>
            </div>
          </section>
        </form>
      </div>
      <div class="apply__snaps" data-apply-snaps aria-hidden="true"></div>
    </div>
  </div>

  <nav class="apply__rail" data-apply-rail aria-label="Steps"></nav>
</main>

<style>
  .apply { position: relative; color: #f5f6f7; font-family: var(--font-site); }
  .apply__shade, .apply__scroller { position: fixed; inset: 0; }
  /* The fluid starts under the header, so dye and currents stop at its edge instead of running behind it. */
  .apply__fluid { position: fixed; left: 0; right: 0; top: var(--apply-fluid-top, 0px); bottom: 0; z-index: 0; width: 100%; display: block; background: #0a0a0a; }
  /* The shade lifts the reading column off the fluid; the swimmer sits above it so it is never dimmed by it. */
  .apply__shade { z-index: 1; pointer-events: none; background: radial-gradient(ellipse 62% 78% at 30% 50%, rgb(10 10 10 / .6), rgb(10 10 10 / .2) 60%, transparent 100%); }
  .apply__swimmer { position: fixed; left: 0; top: 0; z-index: 2; pointer-events: none; visibility: hidden; filter: drop-shadow(0 14px 18px rgb(0 0 0 / .35)); }
  .apply__scroller { z-index: 3; overflow-y: auto; overflow-x: hidden; scroll-snap-type: y mandatory; overscroll-behavior: contain; scrollbar-width: none; }
  .apply__scroller::-webkit-scrollbar, .apply__step::-webkit-scrollbar { display: none; }
  /* The deck is one screen per step; the stage stays pinned while the scroll position drives the morph between two steps. */
  .apply__deck { position: relative; height: calc(var(--apply-steps, 1) * 100%); }
  .apply__stage { position: sticky; top: 0; height: calc(100% / var(--apply-steps, 1)); }
  .apply__snaps { position: absolute; inset: 0; display: flex; flex-direction: column; pointer-events: none; }
  .apply__snap { flex: 1 1 0; scroll-snap-align: start; scroll-snap-stop: always; }
  .apply__form { display: contents; }
  /* Steps stack on the stage; only the one being read (and the one it morphs into) shows. A step taller than the screen scrolls itself. */
  .apply__step { position: absolute; inset: 0; display: flex; flex-direction: column; overflow-y: auto; overflow-x: hidden; scrollbar-width: none; visibility: hidden; padding: var(--apply-top, 112px) clamp(24px, 5vw, 76px) calc(var(--site-footer-height, 0px) + 32px); }
  .apply__step[data-shown] { visibility: visible; }
  .apply__step { -webkit-mask-image: linear-gradient(to bottom, transparent calc(var(--apply-top, 112px) - 44px), #000 calc(var(--apply-top, 112px) - 8px), #000 calc(100% - var(--site-footer-height, 0px) - 30px), transparent calc(100% - var(--site-footer-height, 0px) + 2px)); mask-image: linear-gradient(to bottom, transparent calc(var(--apply-top, 112px) - 44px), #000 calc(var(--apply-top, 112px) - 8px), #000 calc(100% - var(--site-footer-height, 0px) - 30px), transparent calc(100% - var(--site-footer-height, 0px) + 2px)); }
  .apply__step[hidden] { display: none; }
  .apply__panel { flex: 0 0 auto; width: min(100%, 680px); margin: auto 0 auto max(0px, calc((100% - 1280px) / 2)); will-change: transform, opacity; }
  .apply__panel--wide { width: min(100%, 1040px); }

  /* Type: titles in the site's display face, everything else in Outfit. */
  .apply__title { margin: 0 0 14px; font-family: var(--font-title); font-weight: 600; font-size: clamp(34px, 4.4vw, 56px); line-height: 1.06; letter-spacing: .008em; font-synthesis: none; text-wrap: balance; text-shadow: 0 2px 14px rgb(0 0 0 / .45); }
  .apply__subtitle { margin: 22px 0 4px; font-family: var(--font-title); font-weight: 600; font-size: 22px; letter-spacing: .01em; font-synthesis: none; }
  .apply__lead { margin: 0 0 26px; max-width: 34em; font-size: clamp(17px, 1.5vw, 21px); line-height: 1.45; color: #dfe3e6; }
  .apply__lead a { color: #fff; }
  .apply__help { margin: 0 0 18px; max-width: 36em; font-size: 16px; line-height: 1.45; color: #c7ccd1; }
  .apply__help--tight { margin: 0 0 8px; }

  /* Fields */
  .apply__field { display: block; margin: 0 0 16px; }
  .apply__row { display: grid; grid-template-columns: 1fr 1fr; gap: 0 28px; }
  .apply__label { display: block; margin-bottom: 4px; color: #b4bbc1; font-size: 14px; font-weight: 600; letter-spacing: .01em; }
  .apply__label em { font-style: normal; font-weight: 400; color: #8a9199; }
  .apply__input { display: block; width: 100%; min-width: 0; padding: 7px 0 9px; border: 0; border-bottom: 1px solid rgb(255 255 255 / .35); border-radius: 0; background: none; color: #fff; font: 500 20px/1.3 var(--font-site); letter-spacing: -.005em; transition: border-color 150ms; }
  .apply__input::placeholder { color: rgb(255 255 255 / .34); }
  .apply__input:focus { outline: none; border-bottom-color: #fff; }
  .apply__input--area { resize: none; min-height: 2.4em; field-sizing: content; }
  .apply__input[aria-invalid='true'] { border-bottom-color: #ff8a80; }
  .apply__hint { display: block; margin-top: 5px; color: #9aa1a8; font-size: 14px; min-height: 1.4em; }
  .apply__hint[data-invalid] { color: #ff8a80; }
  .apply__fieldset { border: 0; padding: 0; min-width: 0; }
  .apply__chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 6px; }
  .apply__chips[hidden] { display: none; }
  .apply__chip { position: relative; display: inline-flex; }
  .apply__chip input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .apply__chip span { display: inline-block; padding: 8px 15px; border: 1px solid rgb(255 255 255 / .35); border-radius: 999px; font-size: 15px; font-weight: 500; color: #e6e9ec; transition: background 150ms, color 150ms, border-color 150ms; }
  .apply__chip:hover span { border-color: rgb(255 255 255 / .7); }
  .apply__chip input:checked + span { background: #f3f2ed; border-color: #f3f2ed; color: #232527; }
  .apply__chip input:focus-visible + span { outline: 2px solid #fff; outline-offset: 2px; }
  .apply__chips.is-invalid .apply__chip span { border-color: #ff8a80; }
  /* A two way toggle in the same language as the chips. */
  .apply__segment { position: relative; display: inline-flex; align-self: end; margin-bottom: 4px; padding: 2px; border: 1px solid rgb(255 255 255 / .35); border-radius: 999px; }
  .apply__segment button { padding: 5px 11px; border: 0; border-radius: 999px; background: none; color: #e6e9ec; font: 500 14px/1.3 var(--font-site); white-space: nowrap; cursor: pointer; transition: background 150ms, color 150ms; }
  .apply__segment button[aria-pressed='true'] { background: #f3f2ed; color: #232527; }
  .apply__segment button:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  .apply__check { display: flex; gap: 14px; align-items: flex-start; margin: 10px 0 18px; font-size: 16px; line-height: 1.45; color: #dfe3e6; cursor: pointer; }
  .apply__check input { flex: none; width: 22px; height: 22px; margin-top: 2px; accent-color: #f3f2ed; }
  .apply__check.is-invalid { color: #ff8a80; }
  .apply__check.is-invalid input { outline: 2px solid #ff8a80; outline-offset: 2px; border-radius: 4px; }
  .apply__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 26px; margin-top: 22px; }
  .apply__button { position: relative; isolation: isolate; --folder-button-fill: #f3f2ed; --folder-button-stroke: rgb(255 255 255 / .85); display: inline-flex; align-items: center; justify-content: center; min-height: 60px; min-width: 180px; padding: 20px 30px 16px; border: 0; background: none; color: #232527; font: 550 20px/1.2 var(--font-site); letter-spacing: -.01em; text-decoration: none; cursor: pointer; }
  .apply__button :global(.folder-button-shape) { filter: drop-shadow(0 5px 8px rgb(0 0 0 / .18)) drop-shadow(0 1px 2px rgb(0 0 0 / .12)); }
  .apply__button > span { position: relative; z-index: 1; }
  .apply__button:hover { --folder-button-fill: #fff; --folder-button-stroke: #fff; }
  .apply__button:focus-visible { outline: 2px solid #fff; outline-offset: 4px; border-radius: 8px; }
  .apply__button[disabled] { opacity: .6; cursor: progress; }
  .apply__link { padding: 10px 2px; border: 0; background: none; color: #e6e9ec; font: 500 16px/1.2 var(--font-site); text-decoration: underline; text-underline-offset: 4px; text-decoration-color: rgb(255 255 255 / .4); cursor: pointer; }
  .apply__link:hover { text-decoration-color: #fff; }
