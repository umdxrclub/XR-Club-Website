---
import FolderButtonShape from '../../components/FolderButtonShape.astro';
import { availabilityOptions, fundingRules, teams, years } from './applyContent';
---
<main class="apply" data-apply data-arrival-hold>
  <canvas class="apply__fluid" data-apply-fluid aria-hidden="true"></canvas>
  <div class="apply__shade" aria-hidden="true"></div>
  <canvas class="apply__swimmer" data-apply-swimmer aria-hidden="true"></canvas>
  <div class="apply__content">
    <form data-apply-form novalidate>
      <section data-step="basics" aria-labelledby="apply-title">
        <div class="apply__columns">
          <fieldset class="apply__basics">
            <legend class="sr-only">Your details</legend>
            <header class="apply__heading"><h1 id="apply-title" tabindex="-1">Project Applications</h1><p>Join a project or request funding for your own idea.</p></header>
            <div class="apply__row">
              <label class="apply__field"><span class="apply__label">Name</span><input class="apply__input" name="full_name" autocomplete="name" required maxlength="200" /></label>
              <label class="apply__field"><span class="apply__label">UMD email</span><input class="apply__input" name="email" type="email" autocomplete="email" required maxlength="320" placeholder="you@umd.edu" /></label>
            </div>
            <div class="apply__row">
              <label class="apply__field"><span class="apply__label">Discord username</span><input class="apply__input" name="discord_username" autocomplete="off" required maxlength="100" /></label>
              <label class="apply__field"><span class="apply__label">Major <em>and minor, if any</em></span><input class="apply__input" name="major" required maxlength="200" /></label>
            </div>
            <fieldset class="apply__field"><legend class="apply__label">Year</legend><div class="apply__chips">{years.map(year => <label class="apply__chip"><input type="radio" name="year" value={year} required /><span>{year}</span></label>)}</div></fieldset>
            <div class="apply__actions"><button class="apply__button" type="button" data-continue><FolderButtonShape tabSide="right" /><span>Continue</span></button></div>
          </fieldset>
          <fieldset class="apply__choices" tabindex="-1">
            <legend class="apply__label">Choose an application</legend>
            <div class="apply__cards">
              {teams.map(team => <label class="apply__card"><input type="radio" name="application" value={team.slug} required /><FolderButtonShape shortTab tabSide="right" /><span class="apply__card-body"><strong class="apply__card-name">{team.name}</strong><span class="apply__card-text">{team.tagline}</span><span class="apply__card-cta" aria-hidden="true"></span></span></label>)}
              <label class="apply__card"><input type="radio" name="application" value="funding" required /><FolderButtonShape shortTab tabSide="right" /><span class="apply__card-body"><strong class="apply__card-name">Apply for funding</strong><span class="apply__card-text">Up to $400 solo or $1,000 with a team.</span><span class="apply__card-cta" aria-hidden="true"></span></span></label>
            </div>
            <p class="apply__choice-error" id="application-error" data-application-error role="alert" hidden>Choose an application to continue.</p>
          </fieldset>
        </div>
      </section>
      <section data-step="details" hidden aria-labelledby="details-title">
        <header class="apply__heading"><h1 id="details-title" tabindex="-1" data-details-title></h1></header>
        <fieldset class="apply__columns" data-team-fields disabled hidden>
          <legend class="sr-only">Project application</legend>
          <div class="apply__context">
            {teams.map(team => <div data-project-info={team.slug} hidden>
              {team.summary.map((paragraph, index) => <p>{paragraph}{index === team.summary.length - 1 && <> <button type="button" class="apply__more" data-open-project-details aria-haspopup="dialog">More details</button></>}</p>)}
            </div>)}
            <fieldset class="apply__field"><legend class="apply__label">Tools you have used <em>optional</em></legend>
              {teams.map(team => <div class="apply__chips" data-project-tools={team.slug} hidden>{team.tools.map(tool => <label class="apply__chip"><input type="checkbox" name="tools" value={tool} /><span>{tool}</span></label>)}</div>)}
            </fieldset>
            <label class="apply__field"><span class="apply__label">Link <em>optional</em></span><input class="apply__input" name="link" type="url" maxlength="1000" placeholder="Portfolio, GitHub, or a video" /></label>
          </div>
          <div>
            <label class="apply__field"><span class="apply__label" data-project-question></span><textarea class="apply__input" name="pitch" rows="3" required maxlength="5000" placeholder="A few sentences is enough"></textarea></label>
            <fieldset class="apply__field"><legend class="apply__label">Availability</legend><p class="apply__help" data-meeting></p><div class="apply__chips">{availabilityOptions.map(option => <label class="apply__chip"><input type="radio" name="availability" value={option.value} required /><span>{option.label}</span></label>)}</div></fieldset>
          </div>
        </fieldset>
        <fieldset class="apply__columns" data-funding-fields disabled hidden>
          <legend class="sr-only">Funding application</legend>
          <div class="apply__funding-outline">
            <p class="apply__help" data-funding-info>Tell us about your idea!</p>
            <label class="apply__field apply__funding-name"><span class="apply__label">Project Title</span><input class="apply__input" name="project_title" required maxlength="200" /></label>
            <label class="apply__field apply__funding-idea"><span class="apply__label">What do you want to make?</span><textarea class="apply__input" name="idea" rows="2" required maxlength="2000"></textarea></label>
            <label class="apply__field apply__funding-why"><span class="apply__label">Why do you want to make it?</span><textarea class="apply__input" name="motivation" rows="2" required maxlength="1200"></textarea></label>
            <fieldset class="apply__field apply__funding-mode"><legend class="apply__label">Who is working on it?</legend><div class="apply__chips"><label class="apply__chip"><input type="radio" name="funding_mode" value="solo" checked /><span>Just me</span></label><label class="apply__chip"><input type="radio" name="funding_mode" value="team" /><span>A team</span></label></div></fieldset>
          </div>
          <div class="apply__budget">
            <h2 class="apply__label">What do you need to buy?</h2>
            <div data-budget-rows></div>
            <template data-budget-template><div class="apply__budget-row">
              <label class="apply__field"><span class="apply__label">Item</span><input class="apply__input" name="budget_name" maxlength="200" required placeholder="Equipment or parts" /></label>
              <div class="apply__field apply__cost">
                <label><span class="apply__label">Cost ($)</span><input class="apply__input" name="budget_cost" type="number" min="0.01" step="0.01" required placeholder="0.00" /></label>
                <div class="apply__cost-controls">
                  <button type="button" data-cost-step="up" aria-label="Increase cost"><svg viewBox="0 0 12 8" aria-hidden="true"><path d="m2 6 4-4 4 4" /></svg></button>
                  <button type="button" data-cost-step="down" aria-label="Decrease cost"><svg viewBox="0 0 12 8" aria-hidden="true"><path d="m2 2 4 4 4-4" /></svg></button>
                </div>
              </div>
              <button type="button" class="apply__remove" data-remove-item aria-label="Remove item">×</button>
              <label class="apply__field apply__product-link"><span class="apply__label">Product link</span><input class="apply__input" name="budget_link" type="url" maxlength="1000" required placeholder="https://amazon.com/… or another retailer" /></label>
            </div></template>
            <div class="apply__budget-foot"><button type="button" class="apply__back" data-add-item>Add item</button><p class="apply__total">Total <strong data-budget-total>$0</strong></p></div>
            <p class="apply__hint" data-budget-limit>Up to $400 for a solo project.</p><p class="apply__error" data-budget-error hidden></p>
            <div class="apply__notice"><button class="apply__back" type="button" data-open-rules aria-haspopup="dialog">Read the funding rules</button></div>
            <label class="apply__check"><input type="checkbox" name="agreed_to_rules" required /><span>I have read the funding rules and understand what can and cannot be funded.</span></label>
          </div>
          <fieldset class="apply__members" data-members-field disabled hidden>
            <legend class="sr-only">Team members</legend>
            <div class="apply__members-heading"><h2 class="apply__label">Team members <em>except yourself</em></h2><button type="button" class="apply__back" data-add-member>Add member</button></div>
            <div data-member-rows></div>
            <template data-member-template><div class="apply__member-row">
              <label class="apply__field"><span class="apply__label">Member name</span><input class="apply__input" name="member_name" required maxlength="200" placeholder="Name" /></label>
              <label class="apply__field"><span class="apply__label">Member UMD email</span><input class="apply__input" name="member_email" type="email" required maxlength="320" placeholder="you@umd.edu" /></label>
              <button type="button" class="apply__remove" data-remove-member aria-label="Remove member">×</button>
            </div></template>
          </fieldset>
        </fieldset>
        <div class="apply__actions"><button type="button" class="apply__back" data-back>Back</button><button class="apply__button" type="submit" data-submit><FolderButtonShape tabSide="right" /><span data-submit-label>Submit application</span></button></div>
      </section>
      <label class="apply__honey" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off" /></label>
      <p class="apply__error" data-form-error role="alert" hidden></p>
    </form>
    <section class="apply__done" data-done hidden aria-labelledby="done-title"><h1 id="done-title" tabindex="-1">Application submitted</h1><p>We will review your application and contact you by email or Discord.</p><a class="apply__button" href={import.meta.env.BASE_URL}><FolderButtonShape tabSide="right" /><span>Back to home</span></a></section>
    <noscript><p>Enable JavaScript to complete your application.</p></noscript>
  </div>
  <dialog class="apply__rules-dialog" data-rules-dialog aria-labelledby="funding-rules-title" aria-describedby="funding-rules-intro">
    <header class="apply__rules-header"><div><h2 id="funding-rules-title">Funding rules</h2><p id="funding-rules-intro">Read before you apply. Up to $400 solo or $1,000 with a team.</p></div><button type="button" class="apply__rules-close" data-close-rules aria-label="Close funding rules">×</button></header>
    <div class="apply__rules-body" tabindex="0" role="region" aria-label="Funding rules details">
      <div class="apply__rules-eligibility">
        <section><h3>What can be funded</h3><ul>{fundingRules.can.map(rule => <li>{rule}</li>)}</ul></section>
        <section><h3>What cannot be funded</h3><ul>{fundingRules.cannot.map(rule => <li>{rule}</li>)}</ul></section>
      </div>
      <section><h3>Before you buy</h3><ul>{fundingRules.notes.slice(0, 3).map(rule => <li>{rule}</li>)}</ul></section>
      <section><h3>After approval</h3><p>{fundingRules.notes[3]}</p></section>
      <p class="apply__rules-equipment">{fundingRules.notes[4]}</p>
    </div>
    <footer class="apply__rules-footer"><button type="button" data-close-rules>Back to application</button></footer>
  </dialog>
  <dialog class="apply__rules-dialog apply__project-dialog" data-project-details-dialog aria-labelledby="project-details-title">
    <header class="apply__rules-header"><h2 id="project-details-title" data-project-details-title></h2><button type="button" class="apply__rules-close" data-close-project-details aria-label="Close project details">×</button></header>
    <div class="apply__rules-body" data-project-details-body tabindex="0" role="region" aria-label="Full project description">
      {teams.map(team => <div data-project-description={team.slug} hidden>{team.fullDescription.map(paragraph => <p>{paragraph}</p>)}</div>)}
    </div>
    <footer class="apply__rules-footer"><button type="button" data-close-project-details>Back to application</button></footer>
  </dialog>
</main>
<style>
  .apply { position: fixed; inset: 0; --ink: #fff; --ink-body: rgb(255 255 255 / .86); --ink-2: rgb(255 255 255 / .64); --ink-3: rgb(255 255 255 / .42); --line: rgb(255 255 255 / .22); --line-strong: rgb(255 255 255 / .5); --paper: #f3f2ed; --paper-ink: #1d1d1f; --paper-ink-2: #6e6e73; --error: #ff8a80; --column: 1100px; color: var(--ink); font-family: var(--font-site); }
  .apply [hidden] { display: none !important; }
  .apply__fluid, .apply__shade { position: fixed; inset: 0; width: 100%; height: 100%; }
  .apply__fluid { z-index: 0; display: block; background: #0a0a0a; }
  .apply__shade { z-index: 1; pointer-events: none; background: radial-gradient(ellipse 46% 74% at 50% 54%, rgb(10 10 10 / .62), rgb(10 10 10 / .22) 62%, transparent 100%); }
  .apply__swimmer { position: fixed; left: 0; top: 0; z-index: 2; pointer-events: none; visibility: hidden; filter: drop-shadow(0 14px 18px rgb(0 0 0 / .35)); }
  .apply__content { position: absolute; z-index: 3; top: var(--apply-top, 148px); bottom: calc(var(--site-footer-height, 54px) + 18px); left: 50%; translate: -50% 0; width: min(100% - 2 * clamp(24px, 4vw, 76px), var(--column)); display: flex; flex-direction: column; justify-content: safe center; overflow-y: auto; }
  .apply__content, [data-budget-rows], [data-member-rows], .apply textarea { scrollbar-width: thin; scrollbar-color: rgb(255 255 255 / .38) transparent; }
  .apply__content::-webkit-scrollbar, [data-budget-rows]::-webkit-scrollbar, [data-member-rows]::-webkit-scrollbar, .apply textarea::-webkit-scrollbar { width: 5px; }
  .apply__content::-webkit-scrollbar-thumb, [data-budget-rows]::-webkit-scrollbar-thumb, [data-member-rows]::-webkit-scrollbar-thumb, .apply textarea::-webkit-scrollbar-thumb { background: rgb(255 255 255 / .38); border-radius: 999px; }
  .apply__content::-webkit-scrollbar-track, [data-budget-rows]::-webkit-scrollbar-track, [data-member-rows]::-webkit-scrollbar-track, .apply textarea::-webkit-scrollbar-track { background: transparent; }
  .apply__content > form { flex: 0 0 auto; }
  .apply__heading { margin-bottom: 24px; }
  .apply h1 { margin: 0; font-family: var(--font-title); font-weight: 600; font-size: clamp(32px, 4vw, 48px); line-height: 1.08; letter-spacing: .006em; font-synthesis: none; text-wrap: balance; }
  .apply h1:focus { outline: none; }
  .apply__heading p, .apply__done p { margin-top: 12px; font-size: 18px; line-height: 1.5; color: var(--ink-2); }
  .apply__columns { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: 20px clamp(28px, 4vw, 56px); align-items: start; }
  .apply fieldset { border: 0; padding: 0; min-width: 0; }
  .apply__choices > legend { padding: 0; margin-bottom: 22px; font: 600 clamp(22px, 2.2vw, 28px)/1.15 var(--font-title); letter-spacing: .006em; color: var(--ink); }
  .apply__field { display: block; margin: 0 0 18px; }
  .apply__row { display: grid; grid-template-columns: 1fr 1fr; gap: 0 24px; }
  .apply__label { display: block; margin-bottom: 6px; color: var(--ink-2); font-size: 14px; line-height: 1.4; font-weight: 500; }
  .apply__label em { font-style: normal; color: var(--ink-3); }
  .apply__input { display: block; width: 100%; min-width: 0; padding: 8px 0 10px; border: 0; border-bottom: 1px solid var(--line-strong); border-radius: 0; background: none; color: var(--ink); font: 500 18px/1.35 var(--font-site); transition: border-color 150ms; }
  .apply__input::placeholder { color: var(--ink-3); }
  .apply__input:focus { outline: none; border-bottom-color: var(--ink); }
  .apply textarea { resize: none; }
  .apply__input[aria-invalid='true'] { border-bottom-color: var(--error); }
  .apply__chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 6px; }
  .apply__chip { position: relative; display: inline-flex; }
  .apply__chip input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .apply__chip span { display: inline-block; padding: 8px 15px; border: 1px solid var(--line-strong); border-radius: 999px; font-size: 15px; font-weight: 500; color: var(--ink); transition: background 150ms, color 150ms, border-color 150ms; }
  .apply__chip:hover span { border-color: var(--ink); }
  .apply__chip input:checked + span { background: var(--paper); border-color: var(--paper); color: var(--paper-ink); }
  .apply__chip input:focus-visible + span { outline: 2px solid #fff; outline-offset: 2px; }
  .apply__chip input[aria-invalid='true'] + span { border-color: var(--error); }
  .apply__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 28px; margin-top: 20px; padding: 4px 4px 8px; }
  .apply__button { position: relative; isolation: isolate; --folder-button-fill: var(--paper); --folder-button-stroke: none; display: inline-flex; align-items: center; justify-content: center; min-height: 58px; min-width: 176px; padding: 20px 30px 16px; border: 0; background: none; color: var(--paper-ink); font: 550 19px/1.2 var(--font-site); text-decoration: none; cursor: pointer; }
  .apply__button :global(.folder-button-shape) { filter: drop-shadow(0 5px 8px rgb(0 0 0 / .18)) drop-shadow(0 1px 2px rgb(0 0 0 / .12)); }
  .apply__button > span { position: relative; z-index: 1; }
  .apply__button:hover { --folder-button-fill: #fff; }
  .apply__button:focus-visible { outline: none; --folder-button-fill: #d9d0ff; }
  .apply__button:focus-visible > span { text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 2px; }
  .apply button:disabled { opacity: .6; cursor: default; }
  .apply__back { padding: 10px 2px; border: 0; background: none; color: var(--ink-2); font: 500 16px/1.2 var(--font-site); text-decoration: underline; text-underline-offset: 4px; text-decoration-color: var(--line); cursor: pointer; }
  .apply__back:hover { color: var(--ink); text-decoration-color: var(--ink); }
  .apply__back:focus-visible { outline: 2px solid #fff; outline-offset: 3px; border-radius: 4px; }
  .apply__cards { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin: 4px; }
  .apply__card { position: relative; isolation: isolate; --folder-button-fill: var(--paper); --folder-button-stroke: none; display: flex; min-height: 172px; padding: 30px 20px 18px; border: 0; background: none; color: var(--paper-ink); cursor: pointer; }
  .apply__card > input { position: absolute; inset: 0; opacity: 0; cursor: pointer; z-index: 2; width: 100%; height: 100%; }
  .apply__card :global(.folder-button-shape) { filter: drop-shadow(0 10px 14px rgb(0 0 0 / .22)); transition: transform 220ms cubic-bezier(.2,.7,.2,1); }
  .apply__card:hover { --folder-button-fill: #fff; }
  .apply__card:has(input:checked) { --folder-button-fill: #d9d0ff; }
  .apply__card:has(input:checked) .apply__card-cta { color: #463579; font-weight: 700; }
  .apply__card:has(input:focus-visible) { --folder-button-fill: #cbbbff; }
  .apply__card:has(input:focus-visible) .apply__card-cta { text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 2px; }
  .apply__choices:focus { outline: none; }
  .apply__choice-error { margin: 12px 4px 0; color: #d9d0ff; font-size: 15px; line-height: 1.4; }
  .apply__card-body { position: relative; z-index: 1; display: flex; flex-direction: column; gap: 8px; width: 100%; pointer-events: none; }
  .apply__card-name { font: 600 22px/1.1 var(--font-title); letter-spacing: .004em; font-synthesis: none; }
  .apply__card-text { font-size: 15px; line-height: 1.45; color: var(--paper-ink-2); }
  .apply__card-cta { margin-top: auto; padding-top: 8px; font-size: 15px; font-weight: 600; }
  .apply__card-cta::after { content: 'Select'; }
  .apply__card:has(input:checked) .apply__card-cta::after { content: 'Selected'; }
  .apply__context p { margin: 0 0 18px; font-size: 16px; line-height: 1.55; color: var(--ink-body); }
  .apply__more { padding: 0; border: 0; background: none; color: var(--ink); font: inherit; text-decoration: underline; text-underline-offset: 4px; cursor: pointer; white-space: nowrap; }
  .apply__more:focus-visible { outline: 2px solid var(--ink); outline-offset: 4px; border-radius: 3px; }
  .apply__project-dialog .apply__rules-body p + p { margin-top: 18px; }
  .apply__help { margin: 0 0 12px; font-size: 15px; line-height: 1.5; color: var(--ink-2); }
  .apply__hint { margin: 6px 0 12px; font-size: 13px; line-height: 1.4; color: var(--ink-3); }
  .apply__funding-outline { display: grid; grid-template-columns: 1fr 1fr; gap: 0 18px; }
  .apply__funding-outline > .apply__help, .apply__funding-idea, .apply__funding-why, .apply__members { grid-column: 1 / -1; }
  .apply__funding-name { grid-column: 1; }
  .apply__funding-mode { grid-column: 2; grid-row: 2; }
  .apply__members { padding-top: 16px !important; border-top: 1px solid var(--line) !important; }
  .apply__members-heading { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 12px; }
  .apply__members-heading .apply__label { margin: 0; font-size: 16px; }
  .apply__members-heading .apply__label em { margin-left: 6px; font-size: 14px; font-weight: 400; }
  .apply__members-heading .apply__back { padding: 6px 0; font-size: 16px; white-space: nowrap; }
  .apply__member-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr) 40px; gap: 24px; align-items: end; }
  .apply__member-row + .apply__member-row { margin-top: 18px; }
  .apply__member-row .apply__field { margin: 0; }
  .apply__member-row .apply__input { font-size: 18px; }
  .apply__member-row .apply__remove { width: 40px; height: 40px; }
  [data-member-rows] { padding: 2px; }
  .apply__budget-row { display: grid; grid-template-columns: minmax(0, 1fr) 108px 30px; gap: 8px 12px; align-items: end; padding-bottom: 14px; }
  .apply__budget-row .apply__field { margin: 0; }
  .apply__product-link { grid-column: 1 / -1; }
  .apply__product-link .apply__input { font-size: 15px; }
  .apply__budget-row .apply__input { font-size: 17px; }
  .apply__cost { position: relative; }
  .apply__cost input { appearance: textfield; padding-right: 30px; }
  .apply__cost input::-webkit-inner-spin-button, .apply__cost input::-webkit-outer-spin-button { appearance: none; margin: 0; }
  .apply__cost-controls { position: absolute; right: 0; bottom: 5px; display: flex; flex-direction: column; gap: 2px; }
  .apply__cost-controls button { display: grid; place-items: center; width: 25px; height: 16px; padding: 0; border: 1px solid var(--line); border-radius: 5px; background: transparent; color: var(--ink-2); cursor: pointer; }
  .apply__cost-controls button:hover { background: var(--paper); border-color: var(--paper); color: var(--paper-ink); }
  .apply__cost-controls button:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .apply__cost-controls svg { width: 10px; height: 7px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  [data-budget-rows] { padding: 2px; }
  .apply__remove { width: 30px; height: 36px; border: 0; border-radius: 50%; background: none; color: var(--ink-3); font-size: 24px; cursor: pointer; }
  .apply__remove:hover { color: var(--ink); background: rgb(255 255 255 / .1); }
  .apply__budget-foot { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .apply__total { font-size: 15px; color: var(--ink-2); }
  .apply__total strong { font-size: 19px; font-weight: 500; color: var(--ink); margin-left: 6px; }
  .apply__notice { margin: 10px 0 14px; padding-top: 10px; }
  .apply__notice .apply__back { padding: 0; color: var(--ink); }
  .apply__rules-dialog { width: min(800px, calc(100% - 32px)); max-height: calc(100dvh - 48px); margin: auto; padding: 0; border: 1px solid rgb(255 255 255 / .3); border-radius: 16px; background: var(--paper); color: var(--paper-ink); box-shadow: 0 24px 80px #0006; font-family: var(--font-site); }
  .apply__rules-dialog[open] { display: flex; flex-direction: column; }
  .apply__rules-dialog::backdrop { background: rgb(0 0 0 / .65); }
  .apply__rules-header { display: flex; justify-content: space-between; gap: 20px; padding: 24px 28px 20px; border-bottom: 1px solid #1d1d1f24; }
  .apply__rules-header h2 { margin: 0; font: 600 30px/1.15 var(--font-title); }
