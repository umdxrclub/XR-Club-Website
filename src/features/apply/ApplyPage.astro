---
import { Image } from 'astro:assets';
import FolderButtonShape from '../../components/FolderButtonShape.astro';
import { availabilityOptions, fundingRules, proposal, teams, whatHappensNext, years } from './applyContent';
import poster1 from '../../assets/apply/immersive-installations-poster-1.png';
import poster2 from '../../assets/apply/immersive-installations-poster-2.png';
const base = import.meta.env.BASE_URL;
const posters = [poster1, poster2];
---
<main class="apply" data-apply data-arrival-hold>
  <canvas class="apply__fluid" data-apply-fluid aria-hidden="true"></canvas>
  <div class="apply__shade" aria-hidden="true"></div>
  <canvas class="apply__swimmer" data-apply-swimmer aria-hidden="true"></canvas>
  {/* One segment per step of the whole process, aligned with the page; the script fills it. */}
  <nav class="apply__progress" data-apply-rail aria-label="Steps" hidden>
    <div class="apply__progress-track" data-progress-track></div>
    <span class="apply__progress-count" data-progress-count></span>
  </nav>

  <div class="apply__scroller" data-apply-scroller>
    {/* Every step is a page of paper on one stage pinned to the screen; the scroller behind it only supplies the position that drives the morph. */}
    <div class="apply__deck" data-apply-deck>
      <div class="apply__stage" data-apply-stage>
        {/* Everyone starts here: who you are. Both an application and a proposal use these details. */}
        <section class="apply__step" data-step="intro" data-flow="start" data-shown>
          <div class="apply__panel" data-basics>
            <div class="apply__sheet">
              <div class="apply__sheet-paper" aria-hidden="true"><div class="apply__sheet-paper-inner" data-sheet-paper></div></div>
              <div class="apply__sheet-body">
                <h1 class="apply__title">Projects</h1>
                <p class="apply__lead">Join one of three projects this semester, or propose your own and request funding. Start with a few details.</p>
                <div class="apply__row">
                  <label class="apply__field"><span class="apply__label">Name</span><input class="apply__input" name="full_name" type="text" required maxlength="120" autocomplete="name" /></label>
                  <label class="apply__field"><span class="apply__label">UMD email</span><input class="apply__input" name="email" type="email" required maxlength="160" autocomplete="email" placeholder="you@terpmail.umd.edu" data-umd-email data-hint="Enter a umd.edu or terpmail.umd.edu address" /></label>
                </div>
                <div class="apply__row">
                  <label class="apply__field"><span class="apply__label">Discord username</span><input class="apply__input" name="discord_username" type="text" required maxlength="80" autocomplete="off" /></label>
                  <label class="apply__field"><span class="apply__label">Major <em>and minor, if any</em></span><input class="apply__input" name="major" type="text" required maxlength="160" /></label>
                </div>
                <fieldset class="apply__field apply__fieldset">
                  <legend class="apply__label">Year</legend>
                  <div class="apply__chips apply__chips--radio">
                    {years.map(year => <label class="apply__chip"><input type="radio" name="year" value={year} required /><span>{year}</span></label>)}
                  </div>
                </fieldset>
                <div class="apply__actions"><button type="button" class="apply__button" data-next><FolderButtonShape /><span>Continue</span></button></div>
              </div>
            </div>
          </div>
        </section>

        <section class="apply__step" data-step="choose" data-flow="start">
          <div class="apply__panel">
            <div class="apply__sheet">
              <div class="apply__sheet-paper" aria-hidden="true"><div class="apply__sheet-paper-inner" data-sheet-paper></div></div>
              <div class="apply__sheet-body">
                <h2 class="apply__title">Choose a project</h2>
                <p class="apply__lead">Join a project that is taking members, or propose a new one and request funding.</p>
                <div class="apply__options" role="list">
                  {teams.map(team => (
                    <button type="button" class="apply__option" role="listitem" data-team-pick={team.slug}>
                      <span class="apply__option-name">{team.name}</span>
                      <span class="apply__option-cta">Apply</span>
                      <span class="apply__option-text">{team.tagline}</span>
                    </button>
                  ))}
                  <button type="button" class="apply__option" role="listitem" data-pitch-pick>
                    <span class="apply__option-name">{proposal.name}</span>
                    <span class="apply__option-cta">{proposal.cta}</span>
                    <span class="apply__option-text">{proposal.tagline}</span>
                  </button>
                </div>
                <div class="apply__actions"><button type="button" class="apply__link" data-back>Back</button></div>
              </div>
            </div>
          </div>
        </section>

        {/* Each branch stays off the deck until it is chosen, so scrolling cannot skip the choice. */}
        <form class="apply__form" data-apply-form="team" novalidate autocomplete="on">
          <input type="hidden" name="team" data-team-field />
          <input type="text" name="website" class="apply__honey" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <section class="apply__step" data-step="team-info" data-flow="team" hidden>
            <div class="apply__panel apply__panel--wide">
              <div class="apply__sheet">
                <div class="apply__sheet-paper" aria-hidden="true"><div class="apply__sheet-paper-inner" data-sheet-paper></div></div>
                <div class="apply__sheet-body">
                  {teams.map(team => (
                    <article class="apply__team-info" data-team-info={team.slug} hidden>
                      <h2 class="apply__title">{team.name}</h2>
                      <div class="apply__team-columns">
                        <div class="apply__team-text">
                          {team.summary.map(paragraph => <p>{paragraph}</p>)}
                          {team.roles && <p class="apply__team-roles"><strong>Roles:</strong> {team.roles.join(', ')}</p>}
                          {team.people && <p class="apply__team-roles"><strong>Team:</strong> {team.people.join(', ')}</p>}
                          <div class="apply__actions"><button type="button" class="apply__link" data-back>Other projects</button><button type="button" class="apply__button" data-next><FolderButtonShape /><span>Apply</span></button></div>
                        </div>
                        <div class="apply__team-side">
                          {team.posters && <div class="apply__posters">{posters.map((poster, index) => <Image src={poster} alt={index === 0 ? 'Immersive Installations poster: Mondays 4 to 5 pm, AVW 4176' : 'Poster: audio reactive, body tracking, performance, projection mapping. All immersive installations welcome.'} width={520} widths={[260, 520, 780]} sizes="(max-width: 700px) 42vw, 150px" format="webp" quality={82} loading="lazy" />)}</div>}
                          <dl class="apply__details">{team.details.map(detail => <div><dt>{detail.label}</dt><dd>{detail.value}</dd></div>)}</dl>
                        </div>
                      </div>
                    </article>
                  ))}
                </div>
              </div>
            </div>
          </section>

          <section class="apply__step" data-step="fit" data-flow="team" hidden>
            <div class="apply__panel">
              <div class="apply__sheet">
                <div class="apply__sheet-paper" aria-hidden="true"><div class="apply__sheet-paper-inner" data-sheet-paper></div></div>
                <div class="apply__sheet-body">
                  <h2 class="apply__title">Why this project</h2>
                  {teams.map(team => <p class="apply__lead" data-team-question={team.slug} hidden>{team.question}</p>)}
                  <label class="apply__field"><span class="apply__label">Your answer</span><textarea class="apply__input apply__input--area" name="pitch" required rows="2" maxlength="2000"></textarea></label>
                  <fieldset class="apply__field apply__fieldset">
                    <legend class="apply__label">Tools you have used <em>optional</em></legend>
                    {teams.map(team => (
                      <div class="apply__chips" data-team-tools={team.slug} hidden>
                        {team.tools.map(tool => <label class="apply__chip"><input type="checkbox" name="tools" value={tool} /><span>{tool}</span></label>)}
                      </div>
                    ))}
                  </fieldset>
                  <fieldset class="apply__field apply__fieldset">
                    <legend class="apply__label">Availability</legend>
                    {teams.map(team => <p class="apply__help" data-team-meeting={team.slug} hidden>This team meets {team.meeting}.</p>)}
                    <div class="apply__chips apply__chips--radio">
                      {availabilityOptions.map(option => <label class="apply__chip"><input type="radio" name="availability" value={option.value} required /><span>{option.label}</span></label>)}
                    </div>
                  </fieldset>
                  <div class="apply__row">
                    <label class="apply__field"><span class="apply__label">Link <em>optional</em></span><input class="apply__input" name="link" type="url" maxlength="400" placeholder="Portfolio, GitHub, or a video" data-hint="Enter a full link starting with https://" /></label>
                    <label class="apply__field"><span class="apply__label">Anything else <em>optional</em></span><textarea class="apply__input apply__input--area" name="anything_else" rows="1" maxlength="1000"></textarea></label>
                  </div>
                  <div class="apply__actions"><button type="button" class="apply__link" data-back>Back</button><button type="button" class="apply__button" data-next><FolderButtonShape /><span>Review</span></button></div>
                </div>
              </div>
            </div>
          </section>

          <section class="apply__step" data-step="team-review" data-flow="team" hidden>
            <div class="apply__panel">
              <div class="apply__sheet">
                <div class="apply__sheet-paper" aria-hidden="true"><div class="apply__sheet-paper-inner" data-sheet-paper></div></div>
                <div class="apply__sheet-body">
                  <h2 class="apply__title">Review</h2>
                  <dl class="apply__summary" data-team-summary></dl>
                  <p class="apply__error" data-form-error hidden></p>
                  <div class="apply__actions"><button type="button" class="apply__link" data-back>Back</button><button type="submit" class="apply__button" data-submit><FolderButtonShape /><span>Submit application</span></button></div>
                </div>
              </div>
            </div>
          </section>

          <section class="apply__step" data-step="team-done" data-flow="team" hidden>
            <div class="apply__panel">
              <div class="apply__sheet">
                <div class="apply__sheet-paper" aria-hidden="true"><div class="apply__sheet-paper-inner" data-sheet-paper></div></div>
                <div class="apply__sheet-body">
                  <span class="apply__stamp" aria-hidden="true">Received</span>
                  <h2 class="apply__title">Application received</h2>
                  <p class="apply__lead">The team will reach out on Discord or by email with the next meeting. Join the <a href="https://discord.gg/mn8ZKTwXFQ" target="_blank" rel="noopener noreferrer">XR Club Discord</a> in the meantime.</p>
                  <div class="apply__actions">
                    <a class="apply__button" href={base}><FolderButtonShape /><span>Back to home</span></a>
                    <button type="button" class="apply__link" data-jump="choose">Other projects</button>
                  </div>
                </div>
              </div>
            </div>
          </section>
        </form>

        <form class="apply__form" data-apply-form="pitch" novalidate autocomplete="on">
          <input type="text" name="website" class="apply__honey" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <section class="apply__step" data-step="project" data-flow="pitch" hidden>
            <div class="apply__panel">
              <div class="apply__sheet">
                <div class="apply__sheet-paper" aria-hidden="true"><div class="apply__sheet-paper-inner" data-sheet-paper></div></div>
                <div class="apply__sheet-body">
                  <h2 class="apply__title">Project and team</h2>
                  <div class="apply__row">
                    <label class="apply__field"><span class="apply__label">Project name</span><input class="apply__input" name="project_title" type="text" required maxlength="120" placeholder="Short and memorable" /></label>
                    <label class="apply__field"><span class="apply__label">Topic <em>optional</em></span><input class="apply__input" name="topic" type="text" maxlength="120" placeholder="A board topic or your own direction" /></label>
                  </div>
                  <label class="apply__field"><span class="apply__label">Summary</span><textarea class="apply__input apply__input--area" name="idea" required maxlength="600" rows="2" placeholder="What you are building, who it is for, and why XR"></textarea></label>
                  <label class="apply__field"><span class="apply__label">Team members, one per line</span><textarea class="apply__input apply__input--area" name="members" required rows="3" placeholder="Name, year, role" data-members></textarea><span class="apply__hint" data-members-count></span></label>
                  <div class="apply__actions"><button type="button" class="apply__link" data-back>Back</button><button type="button" class="apply__button" data-next><FolderButtonShape /><span>Continue</span></button></div>
                </div>
              </div>
            </div>
          </section>

          <section class="apply__step" data-step="plan" data-flow="pitch" hidden>
            <div class="apply__panel">
              <div class="apply__sheet">
                <div class="apply__sheet-paper" aria-hidden="true"><div class="apply__sheet-paper-inner" data-sheet-paper></div></div>
                <div class="apply__sheet-body">
                  <h2 class="apply__title">Plan</h2>
                  <label class="apply__field"><span class="apply__label">Outline and MVP</span><textarea class="apply__input apply__input--area" name="outline" required rows="3" placeholder="The smallest version that works, then what you build on top of it"></textarea></label>
                  <label class="apply__field"><span class="apply__label">Plan without funding</span><textarea class="apply__input apply__input--area" name="zero_dollar_plan" required rows="2" placeholder="What you can build with lab equipment alone if funding is reduced or unavailable"></textarea></label>
                  <label class="apply__field"><span class="apply__label">Timeline</span><textarea class="apply__input apply__input--area" name="timeline" required rows="2" placeholder="Checkpoints are every 2 to 3 weeks. What is done at each one, through the end of the semester"></textarea></label>
                  <label class="apply__field"><span class="apply__label">Deliverable</span><textarea class="apply__input apply__input--area" name="deliverable" required rows="2" placeholder="What you will show at Demo Day"></textarea></label>
                  <div class="apply__actions"><button type="button" class="apply__link" data-back>Back</button><button type="button" class="apply__button" data-next><FolderButtonShape /><span>Continue</span></button></div>
                </div>
              </div>
            </div>
          </section>

          <section class="apply__step" data-step="budget" data-flow="pitch" hidden>
            <div class="apply__panel">
              <div class="apply__sheet">
                <div class="apply__sheet-paper" aria-hidden="true"><div class="apply__sheet-paper-inner" data-sheet-paper></div></div>
                <div class="apply__sheet-body">
                  <h2 class="apply__title">Budget</h2>
                  <p class="apply__lead">Hardware only. Mark each item must have or nice to have. Leave this empty if lab equipment is enough.</p>
                  <div class="apply__budget" data-budget>
                    <div class="apply__budget-head" aria-hidden="true"><span>Item</span><span>Estimated cost</span><span>Priority</span></div>
                    <div data-budget-rows></div>
                    <template data-budget-row>
                      <div class="apply__budget-row">
                        <input class="apply__input" type="text" name="budget_name" maxlength="120" placeholder="Item" aria-label="Item" />
                        <input class="apply__input" type="number" name="budget_cost" min="0" step="0.01" inputmode="decimal" placeholder="$" aria-label="Estimated cost in dollars" />
                        <span class="apply__segment" role="group" aria-label="Priority">
                          <button type="button" data-priority="must" aria-pressed="true">Must have</button>
                          <button type="button" data-priority="nice" aria-pressed="false">Nice to have</button>
                          <input type="hidden" name="budget_priority" value="must" />
                        </span>
                        <button type="button" class="apply__remove" data-budget-remove aria-label="Remove item">×</button>
                        <input class="apply__input" type="url" name="budget_link" maxlength="400" placeholder="https://" aria-label="Link" />
                      </div>
                    </template>
                    <div class="apply__budget-foot">
                      <button type="button" class="apply__link" data-budget-add>Add item</button>
                      <p class="apply__total">Total requested <strong data-budget-total>$0</strong></p>
                    </div>
                  </div>
                  <label class="apply__field"><span class="apply__label">Lab equipment you will use <em>optional</em></span><input class="apply__input" name="lab_equipment" type="text" maxlength="300" placeholder="Quest 3, PSVR2, HoloLens, the treadmill" /></label>
                  <details class="apply__rules">
                    <summary>Funding rules</summary>
                    <div class="apply__rules-grid">
                      <div><h3>Funding covers</h3><ul>{fundingRules.can.map(item => <li>{item}</li>)}</ul></div>
                      <div><h3>Funding does not cover</h3><ul>{fundingRules.cannot.map(item => <li>{item}</li>)}</ul></div>
                    </div>
                    <ul class="apply__rules-notes">{fundingRules.notes.map(item => <li>{item}</li>)}</ul>
                  </details>
                  <div class="apply__actions"><button type="button" class="apply__link" data-back>Back</button><button type="button" class="apply__button" data-next><FolderButtonShape /><span>Review</span></button></div>
                </div>
              </div>
            </div>
          </section>

          <section class="apply__step" data-step="pitch-review" data-flow="pitch" hidden>
            <div class="apply__panel">
              <div class="apply__sheet">
                <div class="apply__sheet-paper" aria-hidden="true"><div class="apply__sheet-paper-inner" data-sheet-paper></div></div>
                <div class="apply__sheet-body">
                  <h2 class="apply__title">Review</h2>
                  <dl class="apply__summary" data-pitch-summary></dl>
                  <label class="apply__check"><input type="checkbox" name="agreed_to_rules" required /><span>I have read the funding rules. Hardware only, orders go through the Treasurer, no reimbursements, hardware stays with the club, and funds are released in stages at checkpoints.</span></label>
                  <p class="apply__error" data-form-error hidden></p>
                  <div class="apply__actions"><button type="button" class="apply__link" data-back>Back</button><button type="submit" class="apply__button" data-submit><FolderButtonShape /><span>Submit proposal</span></button></div>
                </div>
              </div>
            </div>
          </section>

          <section class="apply__step" data-step="pitch-done" data-flow="pitch" hidden>
            <div class="apply__panel">
              <div class="apply__sheet">
                <div class="apply__sheet-paper" aria-hidden="true"><div class="apply__sheet-paper-inner" data-sheet-paper></div></div>
                <div class="apply__sheet-body">
                  <span class="apply__stamp" aria-hidden="true">Received</span>
                  <h2 class="apply__title">Proposal received</h2>
                  <ol class="apply__next">{whatHappensNext.map(item => <li>{item}</li>)}</ol>
                  <div class="apply__actions">
                    <a class="apply__button" href={base}><FolderButtonShape /><span>Back to home</span></a>
                    <button type="button" class="apply__link" data-jump="choose">Other projects</button>
                  </div>
                </div>
              </div>
            </div>
          </section>
        </form>
      </div>
      <div class="apply__snaps" data-apply-snaps aria-hidden="true"></div>
    </div>
  </div>
</main>

<style>
  /* Outside the page: white ink on the dark field. Inside the page: dark ink on the club's folder paper. */
  .apply { position: relative; --ink: #fff; --ink-body: rgb(255 255 255 / .86); --ink-2: rgb(255 255 255 / .64); --ink-3: rgb(255 255 255 / .42); --line: rgb(255 255 255 / .22); --line-strong: rgb(255 255 255 / .5); --paper: #f3f2ed; --paper-ink: #1d1d1f; --error: #ff8a80; --column: 680px; color: var(--ink); font-family: var(--font-site); }
  .apply__fluid, .apply__shade, .apply__scroller { position: fixed; inset: 0; }
  .apply__fluid { z-index: 0; width: 100%; height: 100%; display: block; background: #0a0a0a; }
  .apply__shade { z-index: 1; pointer-events: none; background: radial-gradient(ellipse 60% 70% at 50% 55%, rgb(10 10 10 / .3), transparent 100%); }
  .apply__swimmer { position: fixed; left: 0; top: 0; z-index: 2; pointer-events: none; visibility: hidden; filter: drop-shadow(0 14px 18px rgb(0 0 0 / .35)); }
  .apply__scroller { z-index: 3; overflow-y: auto; overflow-x: hidden; scroll-snap-type: y mandatory; overscroll-behavior: contain; scrollbar-width: none; }
  .apply__scroller::-webkit-scrollbar, .apply__step::-webkit-scrollbar { display: none; }
  /* The deck is one screen per step; the stage stays pinned while the scroll position drives the morph between two steps. */
  .apply__deck { position: relative; height: calc(var(--apply-steps, 1) * 100%); }
  .apply__stage { position: sticky; top: 0; height: calc(100% / var(--apply-steps, 1)); }
  .apply__snaps { position: absolute; inset: 0; display: flex; flex-direction: column; pointer-events: none; }
  .apply__snap { flex: 1 1 0; scroll-snap-align: start; scroll-snap-stop: always; }
  .apply__form { display: contents; }
  /* Steps stack on the stage; only the one being read (and the one it morphs into) shows. A step taller than the screen scrolls itself. */
  .apply__step { position: absolute; inset: 0; display: flex; flex-direction: column; overflow-y: auto; overflow-x: hidden; scrollbar-width: none; visibility: hidden; padding: var(--apply-top, 148px) clamp(24px, 5vw, 76px) calc(var(--site-footer-height, 0px) + 36px); }
  .apply__step[data-shown] { visibility: visible; }
  .apply__step { -webkit-mask-image: linear-gradient(to bottom, transparent calc(var(--apply-top, 148px) - 44px), #000 calc(var(--apply-top, 148px) - 8px), #000 calc(100% - var(--site-footer-height, 0px) - 30px), transparent calc(100% - var(--site-footer-height, 0px) + 2px)); mask-image: linear-gradient(to bottom, transparent calc(var(--apply-top, 148px) - 44px), #000 calc(var(--apply-top, 148px) - 8px), #000 calc(100% - var(--site-footer-height, 0px) - 30px), transparent calc(100% - var(--site-footer-height, 0px) + 2px)); }
  .apply__step[hidden] { display: none; }
  .apply__panel { flex: 0 0 auto; width: min(100%, var(--column)); margin: auto; will-change: transform, opacity; }
  .apply__panel--wide { width: min(100%, 960px); }

  /* The page: a sheet of the club's folder paper, with the folder's tab, floating on the fluid. */
  .apply__sheet { position: relative; isolation: isolate; --ink: #1d1d1f; --ink-body: #2c2c2e; --ink-2: #6e6e73; --ink-3: #8e8e93; --line: rgb(0 0 0 / .14); --line-strong: rgb(0 0 0 / .34); --error: #c62828; padding: 62px 56px 44px; color: var(--ink); }
  .apply__sheet-paper { position: absolute; inset: 0; z-index: 0; filter: drop-shadow(0 26px 50px rgb(0 0 0 / .5)) drop-shadow(0 2px 6px rgb(0 0 0 / .3)); }
  .apply__sheet-paper-inner { position: absolute; inset: 0; background: var(--paper); clip-path: inset(0 round 22px); }
  .apply__sheet-body { position: relative; z-index: 1; }
  .apply__sheet .apply__button { --folder-button-fill: #1d1d1f; --folder-button-stroke: #1d1d1f; color: var(--paper); }
  .apply__sheet .apply__button:hover { --folder-button-fill: #000; --folder-button-stroke: #000; }
  .apply__sheet .apply__button :global(.folder-button-shape) { filter: drop-shadow(0 6px 12px rgb(0 0 0 / .22)); }
  .apply__sheet .apply__chip input:checked + span, .apply__sheet .apply__segment button[aria-pressed='true'] { background: #1d1d1f; border-color: #1d1d1f; color: var(--paper); }
  .apply__sheet .apply__chip input:focus-visible + span, .apply__sheet .apply__button:focus-visible, .apply__sheet .apply__link:focus-visible, .apply__sheet .apply__segment button:focus-visible, .apply__sheet .apply__option:focus-visible { outline-color: #1d1d1f; }
  .apply__sheet .apply__check input { accent-color: #1d1d1f; }
  .apply__sheet .apply__input { background: linear-gradient(var(--ink), var(--ink)) no-repeat left bottom / 0 2px; transition: background-size 340ms cubic-bezier(.2,.7,.2,1), border-color 150ms; }
  .apply__sheet .apply__input:focus { background-size: 100% 2px; border-bottom-color: transparent; }
  /* A rubber stamp on the pages that confirm a submission. */
  .apply__stamp { position: absolute; right: 8px; bottom: -4px; padding: 9px 14px 7px; border: 3px solid #b3261e; border-radius: 6px; color: #b3261e; font: 700 20px/1 var(--font-title); letter-spacing: .18em; text-transform: uppercase; transform: rotate(-11deg); opacity: .82; mix-blend-mode: multiply; pointer-events: none; }
  .apply__sheet .apply__remove:hover { background: rgb(0 0 0 / .06); }

  /* The progress bar: one segment per step of the whole process, on the page's left edge just above it. */
  .apply__progress { position: fixed; z-index: 4; left: 50%; top: calc(var(--apply-top, 148px) - 38px); translate: -50% 0; display: flex; align-items: center; gap: 16px; width: min(100% - 2 * clamp(24px, 5vw, 76px), var(--column)); transition: width 320ms cubic-bezier(.2,.7,.2,1); }
  .apply__progress[hidden] { display: none; }
  .apply__progress-track { display: flex; flex: 1; gap: 6px; }
  .apply__progress-track button { position: relative; flex: 1; height: 18px; padding: 0; border: 0; background: none; cursor: pointer; }
