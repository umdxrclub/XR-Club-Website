---
import '../styles/global.css';
import PageTransitions from '../components/PageTransitions.astro';
import outfit from '../assets/fonts/Outfit-Variable.woff2?url';
import titleFont from '../assets/fonts/LabsDisplay-Wordmark.woff2?url';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Design, engineer, and create with XR Club at the University of Maryland.' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" sizes="96x96" href={`${base}favicon-96.png?v=20260927`} />
    <link rel="icon" type="image/svg+xml" sizes="any" href={`${base}favicon.svg?v=20260927`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png?v=20260927`} />
    <link rel="preload" href={outfit} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={titleFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" as="image" href={`${base}brand/xr-labs-header.svg?v=20260927`} fetchpriority="high" />
    <ClientRouter />
    <title>{title}</title>
    <PageTransitions />
    <slot name="head" />
  </head>
  <body class="has-site-footer">
    <slot />
    <Footer />
  </body>
</html>
