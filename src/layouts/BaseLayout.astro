---
import '../styles/global.css';
import ChatBot from '../components/ChatBot.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  /** Pages can leave the Ask XR Club button off */
  chat?: boolean;
}

const { title, description = 'XR Club - University of Maryland', chat = true } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.ico`} sizes="48x48" />
    <link rel="icon" type="image/png" sizes="96x96" href={`${base}favicon-96x96.png`} />
    <link rel="icon" type="image/png" sizes="192x192" href={`${base}favicon-192x192.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Orbitron:wght@700&display=swap" rel="stylesheet" />
    <link rel="preload" as="image" href={`${base}Images/XR logo.webp`} fetchpriority="high" />
    <ClientRouter />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <slot />
    {chat && <ChatBot transition:persist />}
  </body>
</html>
